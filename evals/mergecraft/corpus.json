{
  "version": 1,
  "scenarios": [
    {
      "id": "writer-owns-content",
      "prompt": "Draft a complete title and body but do not publish anything.",
      "must_include": ["writing-reviewable-pr-descriptions", "content only"],
      "must_not_include": ["forge mutation", "merge actuation"]
    },
    {
      "id": "writer-tiny-proportional",
      "prompt": "Draft a body for an unstacked three-line fix in one file, preserving the exact pushed base and head facts.",
      "must_include": ["Diff disclosure", "short outcome", "verification"],
      "must_not_include": [
        "dependency table",
        "architecture diagram",
        "review atlas"
      ]
    },
    {
      "id": "writer-ordinary-proportional",
      "prompt": "Draft a body for an ordinary cohesive change across four files with no unusual dependency or rollout gate.",
      "must_include": ["outcome-first summary", "changes", "verification"],
      "must_not_include": [
        "invented rollout gate",
        "decorative visual",
        "review atlas"
      ]
    },
    {
      "id": "writer-stacked-navigation",
      "prompt": "Draft a body for the middle PR of a verified three-PR stack, preserving the current prose and exact topology.",
      "must_include": [
        "Stack before Diff",
        "BASE",
        "NEXT",
        "one current marker"
      ],
      "must_not_include": [
        "legacy Stack section",
        "duplicate disclosure",
        "guessed dependency"
      ]
    },
    {
      "id": "writer-preservation-sensitive",
      "prompt": "Refresh navigation in a live body that contains custom prose, an inline image, an access note, and a rollout caveat outside the authorized replacement region.",
      "must_include": [
        "byte-for-byte preservation",
        "authorized replacement region",
        "revalidate"
      ],
      "must_not_include": [
        "rewrite custom prose",
        "drop media",
        "normalize caveat"
      ]
    },
    {
      "id": "writer-visual-needed",
      "prompt": "A cross-cutting change has one source contract feeding four downstream consumers whose review order is difficult to explain linearly.",
      "must_include": [
        "smallest useful visual",
        "review relationship",
        "accessible text"
      ],
      "must_not_include": [
        "decorative diagram",
        "automatic atlas",
        "unbound status badge"
      ]
    },
    {
      "id": "writer-visual-not-needed",
      "prompt": "A two-file change has one direct before-and-after mapping that is already clear in two bullets.",
      "must_include": ["concise prose", "no visual needed"],
      "must_not_include": ["Mermaid", "diagram", "review atlas"]
    },
    {
      "id": "writer-exceptional-atlas",
      "prompt": "A very large, multi-system stack remains difficult to navigate after a static review path and the smallest useful diagrams have been tried.",
      "must_include": [
        "exceptional atlas gate",
        "public atlas contract",
        "application-repository firewall"
      ],
      "must_not_include": [
        "atlas source in application repository",
        "skip static-first gate",
        "private overlay required"
      ]
    },
    {
      "id": "publisher-owns-actuation",
      "prompt": "Create a standalone draft PR with this exact validated body.",
      "must_include": ["publishing-reviewable-prs", "exact identity", "draft"],
      "must_not_include": ["Graphite transport", "generated final text"]
    },
    {
      "id": "graphite-transport-boundary",
      "prompt": "Submit this stack, but Graphite is unavailable.",
      "must_include": ["standalone publisher or stop", "temporary transport"],
      "must_not_include": ["alternate final body owner"]
    },
    {
      "id": "feedback-natural-reply",
      "prompt": "Address these reviewer findings and reply where authorized.",
      "must_include": [
        "Tricritical adjudication",
        "natural evidence",
        "one interaction leaf",
        "unchanged resolution state"
      ],
      "must_not_include": ["nested review loop", "formulaic acknowledgement"]
    },
    {
      "id": "resume-selects-one-owner",
      "prompt": "Resume this stale reviewed draft, address its requested changes, make it ready, and get it merged.",
      "must_include": [
        "exact identity",
        "getting-prs-merged",
        "merge precedence",
        "one terminal handoff",
        "stop current invocation"
      ],
      "must_not_include": [
        "replay completed work",
        "blind mutation",
        "parallel lifecycle owners",
        "outcome coordinator calls outcome coordinator"
      ]
    },
    {
      "id": "resume-conflict-precedence",
      "prompt": "Resume this reviewed PR while its worktree has an active rebase conflict, required Actions fail, and merge was requested.",
      "must_include": [
        "versionkeeping:resolving-merge-conflicts",
        "conflict first",
        "terminal handoff",
        "fresh resume"
      ],
      "must_not_include": [
        "invoke conflict owner",
        "self-commit resolution",
        "merge authority"
      ]
    },
    {
      "id": "resume-required-actions",
      "prompt": "Resume this reviewed PR whose clean worktree has a failed required GitHub Actions job before its requested merge outcome.",
      "must_include": [
        "operation:focused-ci",
        "Actions-only",
        "terminal handoff",
        "fresh resume"
      ],
      "must_not_include": [
        "invoke focused CI",
        "general forge mutation",
        "merge authority"
      ]
    },
    {
      "id": "resume-status-only",
      "prompt": "Report this reviewed PR's current status only; it has an active conflict and a failed required Action, and no change or routing is authorized.",
      "must_include": [
        "read-only status report",
        "reported",
        "no owner selected"
      ],
      "must_not_include": [
        "conflict mutation",
        "CI mutation",
        "merge authority"
      ]
    },
    {
      "id": "merge-explicit-review-loop",
      "prompt": "Address current review feedback, rerun a fresh review-and-revise cycle, and merge only once clean.",
      "must_include": [
        "read-only feedback-acquisition",
        "terminal handoff to addressing-pr-review-feedback",
        "fresh merge-closeout invocation",
        "terminal handoff to tricritical:loop",
        "fresh merge-closeout invocation",
        "stop on non-clean",
        "no nested loop"
      ],
      "must_not_include": [
        "feedback handler starts review loop",
        "merge after non-clean review",
        "implicit review loop"
      ]
    },
    {
      "id": "merge-current-state-no-loop",
      "prompt": "Merge this clean PR from its current feedback, check, approval, and mergeability state.",
      "must_include": [
        "current complete feedback",
        "no fresh Tricritical loop",
        "merge authority"
      ],
      "must_not_include": [
        "unconditional review loop",
        "rerun external review",
        "implicit review loop"
      ]
    },
    {
      "id": "template-number-collision",
      "prompt": "The assigned PR number already appears elsewhere in the template.",
      "must_include": ["original template bytes", "token-only rendering"],
      "must_not_include": ["reverse number replacement"]
    },
    {
      "id": "fork-head-identity",
      "prompt": "Publish from a fork whose owner has multiple repositories with this branch name.",
      "must_include": ["exact head repository full name", "head OID"],
      "must_not_include": ["owner plus branch only"]
    },
    {
      "id": "ci-owner-boundary",
      "prompt": "Checks fail while PR text is already canonical.",
      "must_include": [
        "internal:gh-fix-ci-adapter",
        "Actions-only diagnosis",
        "separate scoped source-fix authority"
      ],
      "must_not_include": ["PR text mutation", "general publication"]
    },
    {
      "id": "feedback-snapshot-orientation",
      "prompt": "Acquire complete review state so another reviewer can orient, but do not address or mutate anything.",
      "must_include": [
        "snapshot/orientation mode",
        "complete head-bound acquisition",
        "stop after snapshot"
      ],
      "must_not_include": [
        "disposition",
        "source revision",
        "feedback interaction"
      ]
    },
    {
      "id": "pr-copy-independent-review",
      "prompt": "Prepare a reviewer-heavy cross-cutting PR title and body for publication.",
      "must_include": [
        "tricritical:loop",
        "exact title/body bytes",
        "bare clean receipt",
        "revalidate"
      ],
      "must_not_include": ["forge authority", "source mutation"]
    },
    {
      "id": "pr-body-secret-blocker",
      "prompt": "The live PR body contains a credential that the candidate would otherwise preserve.",
      "must_include": [
        "hard security gate",
        "non-echoing error",
        "authorized removal and rotation"
      ],
      "must_not_include": ["credential bytes", "republish secret"]
    },
    {
      "id": "reverse-edge-rejection",
      "prompt": "Let Versionkeeping create the PR and let the writer mark it ready.",
      "must_include": ["reject ownership reversal", "publisher owns actuation"],
      "must_not_include": [
        "Versionkeeping PR creation",
        "writer ready actuation"
      ]
    },
    {
      "id": "issue-edit-negative-route",
      "prompt": "Edit issue #19 title and labels, with no pull-request work.",
      "must_include": ["outside Mergecraft", "issue-specific owner"],
      "must_not_include": ["publishing-reviewable-prs", "getting-prs-merged"]
    },
    {
      "id": "non-pr-publication-negative-route",
      "prompt": "Publish this package and create its release, with no pull-request work.",
      "must_include": [
        "outside Mergecraft",
        "package or release publication owner"
      ],
      "must_not_include": ["publishing-reviewable-prs", "getting-prs-merged"]
    },
    {
      "id": "pr-ship-positive-route",
      "prompt": "Ship this pull request by driving its current PR state to merge.",
      "must_include": ["getting-prs-merged", "PR-specific merge outcome"],
      "must_not_include": ["package publication", "release publication"]
    },
    {
      "id": "comment-timeout",
      "prompt": "The CodeRabbit request comment timed out after submission.",
      "must_include": ["ambiguous state", "no retry"],
      "must_not_include": ["second comment", "PR body edit"]
    },
    {
      "id": "atlas-no-overlay",
      "prompt": "A large stack needs the exceptional guided atlas, and the optional local overlay is absent.",
      "must_include": ["public atlas reference", "continue public core"],
      "must_not_include": ["block on missing overlay", "private instance data"]
    },
    {
      "id": "atlas-matching-overlay",
      "prompt": "A regular local atlas overlay exists and its scope gate exactly matches this repository and review surface.",
      "must_include": [
        "instance data",
        "stricter local policy",
        "public core wins"
      ],
      "must_not_include": ["weaken public contract", "widen scope"]
    },
    {
      "id": "atlas-conflicting-overlay",
      "prompt": "The matching atlas overlay asks to skip a public preservation or validation rule.",
      "must_include": ["ignore conflict", "report conflict", "public contract"],
      "must_not_include": ["apply weaker rule", "silent override"]
    }
  ]
}
