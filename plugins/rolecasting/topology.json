{
  "schema_version": 4,
  "receipt_contract": {
    "id": "adapter:rolecasting-invocation-topology-receipt",
    "owner": "delegating-cross-agent-work",
    "separate_from": "adapter:model-selection-receipt",
    "binds": [
      "dispatch-identity",
      "product-family",
      "surface",
      "version",
      "executor",
      "relationship",
      "ownership",
      "transport",
      "assurance",
      "consumer-assurance-minimum",
      "isolation",
      "subdelegation-authority",
      "external-action-authority"
    ],
    "default_denies": ["subdelegation", "external-action"]
  },
  "skills": {
    "delegating-cross-agent-work": {
      "owns": [
        "worker-topology",
        "target-surface",
        "worker-relationship",
        "worker-ownership",
        "dispatch-transport",
        "dispatch-assurance",
        "consumer-assurance-minimum",
        "authority",
        "handoffs",
        "native-codex-dispatch",
        "pre-actuator-transition-enforcement",
        "invocation-topology-receipt",
        "leader-integration"
      ],
      "may_call": [
        {
          "skill": "choosing-agent-models",
          "when": "before-every-payload-bearing-dispatch-or-continuation"
        }
      ]
    },
    "choosing-agent-models": {
      "owns": [
        "model-selection",
        "reasoning-effort-selection",
        "capability-proof",
        "model-transition-policy",
        "model-transition-decision"
      ],
      "may_call": []
    }
  }
}
