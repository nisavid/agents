{
  "$defs": {
    "inventory_entry": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "drop-with-reason"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "required": [
              "rationale"
            ]
          }
        }
      ],
      "properties": {
        "disposition": {
          "enum": [
            "drop-with-reason",
            "migrate-to-external-personal-owner",
            "migrate-to-plugin-equipment",
            "retain-as-is"
          ]
        },
        "identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "owner_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        "profile_id": {
          "$ref": "#/$defs/profile_id"
        },
        "rationale": {
          "minLength": 1,
          "type": "string"
        },
        "referenced_materials_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "route_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "external-tool-managed",
            "global-agent-instructions",
            "plugin-provided",
            "recursively-referenced-additional",
            "recursively-referenced-conditional",
            "recursively-referenced-supporting-material",
            "skills-managed",
            "standalone"
          ]
        },
        "surface": {
          "enum": [
            "external-tool-managed-skills",
            "global-agent-instructions",
            "plugin-provided-skills",
            "recursively-referenced-additional-instructions",
            "recursively-referenced-conditional-instructions",
            "recursively-referenced-supporting-materials",
            "skills-managed-skills",
            "standalone-skills"
          ]
        }
      },
      "required": [
        "disposition",
        "identity_sha256",
        "owner_id",
        "profile_id",
        "referenced_materials_sha256",
        "route_id",
        "source_kind",
        "surface"
      ],
      "type": "object"
    },
    "profile_id": {
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "type": "string"
    },
    "profile_manifest": {
      "additionalProperties": false,
      "properties": {
        "observed_at_utc": {
          "$ref": "#/$defs/utc_timestamp"
        },
        "path": {
          "pattern": "^release/source-skill-lineage/installed-hosts/[a-z0-9][a-z0-9._-]*\\.json$",
          "type": "string"
        },
        "profile_id": {
          "$ref": "#/$defs/profile_id"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "observed_at_utc",
        "path",
        "profile_id",
        "sha256"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "surface_counts": {
      "additionalProperties": false,
      "properties": {
        "external-tool-managed-skills": {
          "minimum": 0,
          "type": "integer"
        },
        "global-agent-instructions": {
          "minimum": 0,
          "type": "integer"
        },
        "plugin-provided-skills": {
          "minimum": 0,
          "type": "integer"
        },
        "recursively-referenced-additional-instructions": {
          "minimum": 0,
          "type": "integer"
        },
        "recursively-referenced-conditional-instructions": {
          "minimum": 0,
          "type": "integer"
        },
        "recursively-referenced-supporting-materials": {
          "minimum": 0,
          "type": "integer"
        },
        "skills-managed-skills": {
          "minimum": 0,
          "type": "integer"
        },
        "standalone-skills": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "external-tool-managed-skills",
        "global-agent-instructions",
        "plugin-provided-skills",
        "recursively-referenced-additional-instructions",
        "recursively-referenced-conditional-instructions",
        "recursively-referenced-supporting-materials",
        "skills-managed-skills",
        "standalone-skills"
      ],
      "type": "object"
    },
    "utc_timestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    }
  },
  "$id": "https://raw.githubusercontent.com/nisavid/agents/main/release/source-skill-disposition/final-installed-library-rescout.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "completed_at_utc": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "content_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "contract": {
      "const": "coordinated-final-installed-library-rescout-v1"
    },
    "contribution_ledger_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "disposition_ledger_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "disposition_set": {
      "const": [
        "retain-as-is",
        "migrate-to-plugin-equipment",
        "migrate-to-external-personal-owner",
        "drop-with-reason"
      ]
    },
    "enumerated_profile_ids": {
      "items": {
        "$ref": "#/$defs/profile_id"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true,
      "x-sortedBy": "identity"
    },
    "instruction_inventory": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "complete-installed-instruction-library-v1"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/inventory_entry"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true,
          "x-sortedBy": [
            "profile_id",
            "route_id"
          ],
          "x-uniqueBy": [
            "profile_id",
            "route_id"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256",
          "x-digestOf": "/instruction_inventory/entries",
          "x-digestSerialization": "canonical-json-v1"
        },
        "surface_counts": {
          "$ref": "#/$defs/surface_counts"
        }
      },
      "required": [
        "contract",
        "entries",
        "sha256",
        "surface_counts"
      ],
      "type": "object"
    },
    "profile_manifests": {
      "items": {
        "$ref": "#/$defs/profile_manifest"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true,
      "x-sortedBy": "profile_id",
      "x-uniqueBy": "profile_id"
    },
    "release_refresh_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "rescout_surfaces": {
      "const": [
        "external-tool-managed-skills",
        "global-agent-instructions",
        "plugin-provided-skills",
        "recursively-referenced-additional-instructions",
        "recursively-referenced-conditional-instructions",
        "recursively-referenced-supporting-materials",
        "skills-managed-skills",
        "standalone-skills"
      ]
    },
    "schema_version": {
      "const": 1
    },
    "source_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_sync": {
      "const": "three-way-semantic-reconciliation-of-historical-import-current-source-and-current-plugin"
    },
    "started_at_utc": {
      "$ref": "#/$defs/utc_timestamp"
    }
  },
  "required": [
    "candidate_identity_sha256",
    "completed_at_utc",
    "content_sha256",
    "contract",
    "contribution_ledger_sha256",
    "disposition_ledger_sha256",
    "disposition_set",
    "enumerated_profile_ids",
    "instruction_inventory",
    "profile_manifests",
    "release_refresh_contract_sha256",
    "rescout_surfaces",
    "schema_version",
    "source_manifest_sha256",
    "source_sync",
    "started_at_utc"
  ],
  "title": "Final installed instruction library rescout",
  "type": "object",
  "x-invariants": [
    "started_at_utc <= profile_manifests[].observed_at_utc <= completed_at_utc",
    "started_at_utc <= completed_at_utc",
    "enumerated_profile_ids == sorted(profile_manifests[].profile_id)",
    "enumerated_profile_ids == sorted(unique(instruction_inventory.entries[].profile_id))",
    "instruction_inventory.surface_counts == counts(instruction_inventory.entries[].surface)",
    "instruction_inventory.sha256 == canonical_json_sha256(instruction_inventory.entries)",
    "content_sha256 == canonical_json_sha256(document excluding content_sha256)"
  ]
}
