#!/bin/sh
set -eu

if [ "$#" -lt 1 ] || [ "$1" != "hindsight-embed" ]; then
  printf '%s\n' \
    'hindsight-embed-uvx: expected hindsight-embed as the command' >&2
  exit 64
fi

uvx_executable=${HINDSIGHT_EMBED_UVX_EXECUTABLE:-}
if [ -z "$uvx_executable" ]; then
  printf '%s\n' \
    'hindsight-embed-uvx: HINDSIGHT_EMBED_UVX_EXECUTABLE is required' >&2
  exit 69
fi
case "$uvx_executable" in
  /*) ;;
  *)
    printf '%s\n' \
      'hindsight-embed-uvx: HINDSIGHT_EMBED_UVX_EXECUTABLE must be absolute' >&2
    exit 69
    ;;
esac
if [ ! -f "$uvx_executable" ] || [ ! -x "$uvx_executable" ]; then
  printf '%s\n' \
    'hindsight-embed-uvx: configured uvx is unavailable or not executable' >&2
  exit 69
fi

uvx_directory=${uvx_executable%/*}
if [ -z "$uvx_directory" ]; then
  uvx_directory=/
fi
case "$uvx_directory" in
  *:*)
    printf '%s\n' \
      'hindsight-embed-uvx: configured uvx directory is not PATH-safe' >&2
    exit 69
    ;;
esac

npx_executable=${HINDSIGHT_EMBED_NPX_EXECUTABLE:-}
if [ -z "$npx_executable" ]; then
  printf '%s\n' \
    'hindsight-embed-uvx: HINDSIGHT_EMBED_NPX_EXECUTABLE is required' >&2
  exit 69
fi
case "$npx_executable" in
  /*) ;;
  *)
    printf '%s\n' \
      'hindsight-embed-uvx: HINDSIGHT_EMBED_NPX_EXECUTABLE must be absolute' >&2
    exit 69
    ;;
esac
if [ ! -f "$npx_executable" ] || [ ! -x "$npx_executable" ]; then
  printf '%s\n' \
    'hindsight-embed-uvx: configured npx is unavailable or not executable' >&2
  exit 69
fi

npx_directory=${npx_executable%/*}
if [ -z "$npx_directory" ]; then
  npx_directory=/
fi
case "$npx_directory" in
  *:*)
    printf '%s\n' \
      'hindsight-embed-uvx: configured npx directory is not PATH-safe' >&2
    exit 69
    ;;
esac
PATH="$uvx_directory:$npx_directory:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

# The managed provider runtime is version-gated to Hindsight API 0.9.2. Older
# installation generations do not carry this environment binding, so provide
# the matching API version at the release-owned wrapper boundary. A current
# installation may still bind the same value explicitly from provider policy.
: "${HINDSIGHT_EMBED_API_VERSION:=0.9.2}"
export HINDSIGHT_EMBED_API_VERSION

exec "$uvx_executable" --from 'hindsight-embed==0.8.4' "$@"
