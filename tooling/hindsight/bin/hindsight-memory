        required=True,
    )
    harness_config_reconcile.set_defaults(run=harness_config_reconcile_command)

    harness_config_verify = harness_config_commands.add_parser("verify")
    harness_config_verify.add_argument("--destination", required=True)
    harness_config_verify.add_argument("--generation", required=True)
    harness_config_verify.add_argument("--inventory", required=True)
    harness_config_verify.add_argument("--policy", required=True)
    harness_config_verify.add_argument(
        "--upstream-integration-root", action="append", required=True
    )
    harness_config_verify.add_argument("--plan", required=True)
    harness_config_verify.add_argument("--approval-digest", required=True)
    harness_config_verify.set_defaults(run=harness_config_verify_command)

    harness_config_rollback = harness_config_commands.add_parser("rollback")
    harness_config_rollback.add_argument("--destination", required=True)
    harness_config_rollback.add_argument("--generation", required=True)
    harness_config_rollback.add_argument("--inventory", required=True)
    harness_config_rollback.add_argument("--policy", required=True)
    harness_config_rollback.add_argument(
        "--upstream-integration-root", action="append", required=True
    )
    harness_config_rollback.add_argument("--plan", required=True)
    harness_config_rollback.add_argument("--approval-digest", required=True)
    harness_config_rollback.set_defaults(run=harness_config_rollback_command)

    broker = commands.add_parser("broker")
    broker_commands = broker.add_subparsers(dest="broker_command", required=True)
    serve = broker_commands.add_parser("serve")
    serve.add_argument("--socket", required=True)
    serve.add_argument("--profile", action="append", required=True)
    serve.add_argument("--inactive", action="store_true")
    serve.add_argument("--inventory")
    serve.add_argument("--data-plane-token-env")
    serve.add_argument("--mint-authority-env")
    serve.add_argument("--integration-upgrade-state")
    serve.add_argument("--shutdown-timeout", type=_argparse_timeout, default=5.0)
    serve.set_defaults(run=broker_serve_command)
    broker_status = broker_commands.add_parser("status")
    broker_status.add_argument("--socket", required=True)
    broker_status.add_argument("--profile", action="append", required=True)
    broker_status.add_argument("--inactive", action="store_true")
    broker_status.add_argument("--inventory")
    broker_status.add_argument("--data-plane-token-env")
    broker_status.add_argument("--mint-authority-env")
    broker_status.add_argument("--integration-upgrade-state")
    broker_status.set_defaults(run=broker_status_command)
    broker_stop = broker_commands.add_parser("stop")
    broker_stop.add_argument("--socket", required=True)
    broker_stop.add_argument("--timeout", type=_argparse_timeout, default=5.0)
    broker_stop.set_defaults(run=broker_stop_command)

    session = commands.add_parser("session")
    session_commands = session.add_subparsers(dest="session_command", required=True)
    mint = session_commands.add_parser("mint")
    _add_socket(mint)
    mint.add_argument(
        "--control-capability-env",
        default="HINDSIGHT_MEMORY_CONTROL_CAPABILITY",
    )
    mint.add_argument("--request", required=True)
    mint.add_argument(
        "--ttl-seconds",
        type=_argparse_session_ttl,
        default=DEFAULT_SESSION_TTL_SECONDS,
    )
    mint.set_defaults(run=session_mint_command)
    exchange = session_commands.add_parser("exchange")
    _add_socket(exchange)
    exchange.add_argument("--handle-env", default="HINDSIGHT_MEMORY_SESSION_HANDLE")
    exchange.set_defaults(run=session_exchange_command)
    close = session_commands.add_parser("close")
    _add_socket(close)
    close.add_argument(
        "--capability-env", default="HINDSIGHT_MEMORY_SESSION_CAPABILITY"
    )
    close.add_argument("--sequence", type=int, required=True)
    close.add_argument("--action-id", required=True)
    close.set_defaults(run=session_close_command)

    for name, rpc_method, needs_request in (
        ("recall", "recall", True),
        ("mental_model_fetch", "mental_model_fetch", True),
        ("checkpoint", "transcript_checkpoint", True),
        ("retain_outcome", "retain_outcome", True),
        ("reflect", "reflect", True),
        ("session_status", "session_status", False),
    ):
        method = commands.add_parser(name)
        _add_session_request(method, rpc_method=rpc_method, request=needs_request)

    bridge = commands.add_parser("bridge")
    bridge_commands = bridge.add_subparsers(dest="bridge_command", required=True)
    bridge_serve = bridge_commands.add_parser("serve")
    bridge_serve.add_argument("--socket", required=True)
    bridge_serve.add_argument("--broker-socket", required=True)
    bridge_serve.add_argument("--handle-fd", type=int, required=True)
    bridge_serve.add_argument("--session-id", required=True)
    bridge_serve.add_argument(
        "--harness", choices=("codex", "claude-code", "cursor"), required=True
    )
    bridge_serve.add_argument(
        "--lifetime-seconds",
        type=_argparse_session_ttl,
        default=DEFAULT_SESSION_TTL_SECONDS,
    )
    bridge_serve.set_defaults(run=bridge_serve_command)

    harness = commands.add_parser("harness")
    harness.add_argument("harness_id", choices=("codex", "claude-code", "cursor"))
    harness.add_argument(
        "event",
        choices=(
            "recall",
            "session-start",
            "checkpoint",
            "pre-compact",
            "close",
            "reflect",
            "model",
            "status",
            "tool-recall",
            "launch",
            "stage-gui",
        ),
    )
    harness.add_argument("--bridge")
    harness.add_argument("--bridge-env", default="HINDSIGHT_MEMORY_BRIDGE_LOCATOR")
    harness.add_argument("--locator-dir")
    harness.add_argument("--timeout", type=_argparse_timeout, default=5.0)
    harness.add_argument("--broker-socket")
    harness.add_argument(
        "--control-capability-env", default="HINDSIGHT_MEMORY_CONTROL_CAPABILITY"
    )
    harness.add_argument("--session-id")
    harness.add_argument("--companion-id")
    harness.add_argument("--route")
    harness.add_argument("--bridge-dir")
    harness.add_argument(
        "--ttl-seconds",
        type=_argparse_session_ttl,
        default=DEFAULT_SESSION_TTL_SECONDS,
    )
    harness.add_argument("--command", dest="launch_command", nargs=argparse.REMAINDER)
    harness.set_defaults(run=harness_command)
    return value


def _validate_broker_binding_arguments(
    argument_parser: argparse.ArgumentParser, args: argparse.Namespace
) -> None:
    if getattr(args, "command", None) != "broker" or getattr(
        args, "broker_command", None
    ) not in {"serve", "status"}:
        return
    bindings = (
        args.inventory,
        args.data_plane_token_env,
        args.mint_authority_env,
    )
    if args.inactive and args.integration_upgrade_state:
        argument_parser.error("--inactive cannot be combined with runtime bindings")
    binding_error = _broker_binding_mode_error(args.inactive, bindings)
    if binding_error == "inactive-with-bindings":
        argument_parser.error("--inactive cannot be combined with runtime bindings")
    if binding_error == "active-missing-bindings":
        argument_parser.error(
            "active broker mode requires --inventory, "
            "--data-plane-token-env, and --mint-authority-env"
        )


def _validate_state_directory_argument(
    argument_parser: argparse.ArgumentParser, args: argparse.Namespace
) -> None:
    if args.command in {
        "install",
        "upgrade",
        "verify",
        "rollback",
        "uninstall",
        "service",
        "import",
        "data-identity",
        "operation-recovery",
    }:
        if args.state_dir is not None:
            if args.command != "import":
                argument_parser.error(
                    "portable installation commands read state paths from --config"
                )
        return
    if args.state_dir is None:
        argument_parser.error("--state-dir is required for this command")


def main() -> int:
    try:
        argument_parser = parser()
        args = argument_parser.parse_args()
        _validate_state_directory_argument(argument_parser, args)
        _validate_broker_binding_arguments(argument_parser, args)
        return args.run(args)
    except (
        AdapterError,
        ApplyError,
        BridgeError,
        BrokerError,
        InventoryError,
        IntegrationUpgradeError,
        HarnessPersistenceError,
        GenericImportError,
        ImportValidationError,
        MigrationAdapterError,
        MigrationError,
        PlanError,
        PortableInstallError,
        ProviderRuntimeCompatibilityError,
        ReplayError,
        OperationRecoveryError,
        StrictJsonError,
        UnicodeDecodeError,
        OSError,
        json.JSONDecodeError,
    ) as error:
        print(f"hindsight-memory: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
