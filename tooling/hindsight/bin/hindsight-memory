        if Path(args.receipts).exists()
        else []
    )
    print(json.dumps(generic_import_status(plan, receipts), sort_keys=True))
    return 0


def generic_import_verify_command(args: argparse.Namespace) -> int:
    adapter = _generic_import_http_adapter(args)
    plan = verify_generic_import_plan(read_json(args.plan))
    projection = projection_from_dict(read_json(args.projection))
    receipts = _generic_import_receipts(plan, args.receipts)
    verification = verify_generic_import_receipts(
        adapter,
        plan,
        projection,
        receipts,
    )
    write_private(args.output, verification, create_only=True)
    print(json.dumps(verification, sort_keys=True))
    return 0


def _broker_paths(args: argparse.Namespace) -> tuple[Path, Path, Path]:
    requested_state = Path(args.state_dir).expanduser()
    requested_socket = Path(args.socket).expanduser()
    if not requested_state.is_absolute() or not requested_socket.is_absolute():
        raise BrokerError("BROKER_PATH_INVALID")
    try:
        state_dir = requested_state.resolve(strict=False)
        socket_path = requested_socket.resolve(strict=False)
    except (OSError, RuntimeError):
        raise BrokerError("BROKER_PATH_INVALID") from None
    if socket_path.parent != state_dir:
        raise BrokerError("BROKER_PATH_INVALID")
    if socket_path.name in {
        "broker.pid",
        "broker.lock",
        "broker.signing-key",
    }:
        raise BrokerError("BROKER_PATH_INVALID")
    return state_dir, socket_path, state_dir / "broker.pid"


def _bounded_broker_timeout(value: Any) -> float:
    if (
        type(value) not in (int, float)
        or not math.isfinite(value)
        or not 0 <= value <= 30
    ):
        raise BrokerError("BROKER_TIMEOUT_INVALID")
    return float(value)


def _broker_state_components(path: Path) -> tuple[str, ...]:
    if not hasattr(os, "O_DIRECTORY") or not hasattr(os, "O_NOFOLLOW"):
        raise BrokerError("BROKER_PATH_INVALID")
    absolute = Path(os.path.abspath(path))
    if sys.platform == "darwin" and len(absolute.parts) > 1:
        aliases = {
            "var": ("private", "var"),
            "tmp": ("private", "tmp"),
            "etc": ("private", "etc"),
        }
        replacement = aliases.get(absolute.parts[1])
        if replacement is not None:
            absolute = Path("/").joinpath(*replacement, *absolute.parts[2:])
    return absolute.parts[1:]


def _validate_broker_state_directory(descriptor: int, *, final: bool) -> None:
    metadata = os.fstat(descriptor)
    if not stat.S_ISDIR(metadata.st_mode):
        raise BrokerError("BROKER_PATH_INVALID")
    if metadata.st_uid not in {0, os.geteuid()}:
        raise BrokerError("BROKER_PATH_INVALID")
    mode = stat.S_IMODE(metadata.st_mode)
    if mode & 0o022 and not (metadata.st_uid == 0 and metadata.st_mode & stat.S_ISVTX):
        raise BrokerError("BROKER_PATH_INVALID")
    if final and metadata.st_uid != os.geteuid():
        raise BrokerError("BROKER_PATH_INVALID")
    if final and mode != 0o700:
        raise BrokerError("BROKER_STATE_MODE_INVALID")


def _open_broker_state_directory(state_dir: Path, *, create: bool) -> int | None:
    if not state_dir.is_absolute():
        raise BrokerError("BROKER_PATH_INVALID")
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    components = _broker_state_components(state_dir)
    try:
        descriptor = os.open("/", flags)
    except OSError as error:
        raise BrokerError("BROKER_PATH_INVALID") from error
    try:
        _validate_broker_state_directory(descriptor, final=not components)
        for index, component in enumerate(components):
            final = index == len(components) - 1
            try:
                child = os.open(component, flags, dir_fd=descriptor)
            except FileNotFoundError:
                if not create or not final:
                    if final and not create:
                        os.close(descriptor)
                        return None
                    raise BrokerError("BROKER_PATH_INVALID") from None
                try:
                    os.mkdir(component, 0o700, dir_fd=descriptor)
                except FileExistsError:
                    pass
                else:
                    os.fsync(descriptor)
                child = os.open(component, flags, dir_fd=descriptor)
            except OSError as error:
                raise BrokerError("BROKER_PATH_INVALID") from error
            try:
                _validate_broker_state_directory(child, final=final)
            except Exception:
                os.close(child)
                raise
            os.close(descriptor)
            descriptor = child
        return descriptor
    except Exception:
        os.close(descriptor)
        raise


@contextmanager
def _broker_lifecycle_lock(state_dir: Path, *, deadline: float | None = None):
    directory = _open_broker_state_directory(state_dir, create=False)
    if directory is None:
        raise BrokerError("BROKER_PATH_INVALID")
    flags = os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW
    try:
        descriptor = os.open("broker.lock", flags, 0o600, dir_fd=directory)
    except Exception:
        os.close(directory)
        raise
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != os.geteuid()
            or metadata.st_nlink != 1
        ):
            raise BrokerError("BROKER_LOCK_INVALID")
        os.fchmod(descriptor, 0o600)
        lock_identity = metadata.st_dev, metadata.st_ino
        try:
            current = os.stat("broker.lock", dir_fd=directory, follow_symlinks=False)
        except OSError as error:
            raise BrokerError("BROKER_LOCK_INVALID") from error
        if lock_identity != (current.st_dev, current.st_ino):
            raise BrokerError("BROKER_LOCK_INVALID")
        if deadline is None:
            fcntl.flock(descriptor, fcntl.LOCK_EX)
        else:
            while True:
                try:
                    fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        raise BrokerError("BROKER_STOP_TIMEOUT")
                    time.sleep(min(0.01, remaining))
        metadata = os.fstat(descriptor)
        try:
            current = os.stat("broker.lock", dir_fd=directory, follow_symlinks=False)
        except OSError as error:
            raise BrokerError("BROKER_LOCK_INVALID") from error
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != os.geteuid()
            or metadata.st_nlink != 1
            or stat.S_IMODE(metadata.st_mode) != 0o600
            or lock_identity != (current.st_dev, current.st_ino)
        ):
            raise BrokerError("BROKER_LOCK_INVALID")
        yield directory
    finally:
        try:
            fcntl.flock(descriptor, fcntl.LOCK_UN)
        except OSError:
            pass
        os.close(descriptor)
        os.close(directory)


def _remove_broker_socket(socket_path: Path) -> None:
    try:
        metadata = socket_path.lstat()
    except FileNotFoundError:
        return
    if not stat.S_ISSOCK(metadata.st_mode):
        raise BrokerError("BROKER_PATH_INVALID")
    identity = metadata.st_dev, metadata.st_ino
    current = socket_path.lstat()
    if not stat.S_ISSOCK(current.st_mode) or identity != (
        current.st_dev,
        current.st_ino,
    ):
        raise BrokerError("BROKER_PATH_INVALID")
    socket_path.unlink()


def _remove_broker_socket_entry(directory: int, name: str) -> None:
    try:
        metadata = os.stat(name, dir_fd=directory, follow_symlinks=False)
    except FileNotFoundError:
        return
    if not stat.S_ISSOCK(metadata.st_mode):
        raise BrokerError("BROKER_PATH_INVALID")
    identity = metadata.st_dev, metadata.st_ino
    current = os.stat(name, dir_fd=directory, follow_symlinks=False)
    if identity != (current.st_dev, current.st_ino):
        raise BrokerError("BROKER_PATH_INVALID")
    os.unlink(name, dir_fd=directory)
    os.fsync(directory)


def _broker_state_directory_matches(state_dir: Path, directory: int) -> bool:
    try:
        current = _open_broker_state_directory(state_dir, create=False)
    except BrokerError:
        return False
    if current is None:
        return False
    try:
        expected = os.fstat(directory)
        observed = os.fstat(current)
        return (expected.st_dev, expected.st_ino) == (observed.st_dev, observed.st_ino)
    finally:
        os.close(current)


def _private_broker_state(state_dir: Path, *, create: bool = True) -> bool:
    descriptor = _open_broker_state_directory(state_dir, create=create)
    if descriptor is None:
        return False
    os.close(descriptor)
    return True


def _read_private_file(
    path: Path,
    code: str,
    *,
    minimum_bytes: int,
    maximum_bytes: int,
    missing_ok: bool = False,
) -> bytes | None:
    path = Path(path)
    if path.name in {"", ".", ".."}:
        raise BrokerError(code)
    try:
        directory = _open_broker_state_directory(path.parent, create=False)
    except BrokerError as error:
        raise BrokerError(code) from error
    if directory is None:
        if missing_ok:
            return None
        raise BrokerError(code)
    try:
        return _read_private_entry(
            directory,
            path.name,
            code,
            minimum_bytes=minimum_bytes,
            maximum_bytes=maximum_bytes,
            missing_ok=missing_ok,
        )
    finally:
        os.close(directory)


def _read_private_entry(
    directory: int,
    name: str,
    code: str,
    *,
    minimum_bytes: int,
    maximum_bytes: int,
    missing_ok: bool = False,
) -> bytes | None:
    try:
        descriptor = os.open(
            name,
            os.O_RDONLY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0),
            dir_fd=directory,
        )
    except FileNotFoundError:
        if missing_ok:
            return None
        raise BrokerError(code) from None
    except OSError as error:
        raise BrokerError(code) from error
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != os.geteuid()
            or metadata.st_nlink != 1
            or stat.S_IMODE(metadata.st_mode) != 0o600
            or not minimum_bytes <= metadata.st_size <= maximum_bytes
        ):
            raise BrokerError(code)
        value = os.read(descriptor, maximum_bytes + 1)
    finally:
        os.close(descriptor)
    if len(value) != metadata.st_size:
        raise BrokerError(code)
    return value


def _read_private(path: Path, expected_bytes: int, code: str) -> bytes:
    value = _read_private_file(
        path,
        code,
        minimum_bytes=expected_bytes,
        maximum_bytes=expected_bytes,
    )
    assert value is not None
    return value


def _broker_signing_key(state_dir: Path) -> bytes:
    path = state_dir / "broker.signing-key"
    directory = _open_broker_state_directory(state_dir, create=False)
    if directory is None:
        raise BrokerError("SIGNING_KEY_INVALID")
    try:
        existing = _read_private_entry(
            directory,
            path.name,
            "SIGNING_KEY_INVALID",
            minimum_bytes=32,
            maximum_bytes=32,
            missing_ok=True,
        )
    except Exception:
        os.close(directory)
        raise
    if existing is not None:
        os.close(directory)
        return existing
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
    value = secrets.token_bytes(32)
    try:
        descriptor = os.open(path.name, flags, 0o600, dir_fd=directory)
    except FileExistsError:
        try:
            existing = _read_private_entry(
                directory,
                path.name,
                "SIGNING_KEY_INVALID",
                minimum_bytes=32,
                maximum_bytes=32,
            )
            assert existing is not None
            return existing
        finally:
            os.close(directory)
    except Exception:
        os.close(directory)
        raise
    try:
        identity = None
        metadata = os.fstat(descriptor)
        identity = metadata.st_dev, metadata.st_ino
        os.fchmod(descriptor, 0o600)
        if os.write(descriptor, value) != len(value):
            raise OSError("short signing-key write")
        os.fsync(descriptor)
    except Exception:
        os.close(descriptor)
        try:
            current = os.stat(path.name, dir_fd=directory, follow_symlinks=False)
            if identity == (current.st_dev, current.st_ino):
                os.unlink(path.name, dir_fd=directory)
        except OSError:
            pass
        os.close(directory)
        raise
    else:
        os.close(descriptor)
    try:
        os.fsync(directory)
    except Exception:
        try:
            current = os.stat(path.name, dir_fd=directory, follow_symlinks=False)
            if identity == (current.st_dev, current.st_ino):
                os.unlink(path.name, dir_fd=directory)
            os.fsync(directory)
        finally:
            os.close(directory)
        raise
    else:
        os.close(directory)
    return value


def _broker_peer_pid(connection: socket.socket) -> int | None:
    try:
        if sys.platform == "darwin":
            payload = connection.getsockopt(0, 0x002, 4)
            return struct.unpack("i", payload)[0]
        if sys.platform.startswith("linux"):
            payload = connection.getsockopt(
                socket.SOL_SOCKET, getattr(socket, "SO_PEERCRED", 17), 12
            )
            return struct.unpack("3i", payload)[0]
    except (OSError, struct.error):
        return None
    return None


def _broker_probe(
    socket_path: Path,
    timeout: float = 1.0,
    *,
    expected_pid: int | None = None,
) -> bool:
    try:
        metadata = socket_path.lstat()
        if (
            not stat.S_ISSOCK(metadata.st_mode)
            or stat.S_IMODE(metadata.st_mode) != 0o600
        ):
            return False
        connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        connection.settimeout(timeout)
        with connection:
            connection.connect(str(socket_path))
            if (
                expected_pid is not None
                and _broker_peer_pid(connection) != expected_pid
            ):
                return False
            connection.sendall(BROKER_REQUEST)
            response = connection.makefile("rb").readline(4097)
        value = json.loads(response)
        return value == BROKER_HEALTH_RESPONSE
    except (OSError, json.JSONDecodeError, UnicodeDecodeError):
        return False


def _parse_broker_pid(raw: bytes) -> BrokerProcessIdentity:
    if raw is None:
        return None
    try:
        text = raw.decode("ascii")
    except UnicodeDecodeError as error:
        raise BrokerError("BROKER_PID_INVALID") from error
    try:
        value = json.loads(text)
    except json.JSONDecodeError:
        try:
            legacy_pid = int(text)
        except ValueError as error:
            raise BrokerError("BROKER_PID_INVALID") from error
        if not 1 < legacy_pid <= MAX_SIGNAL_PID:
            raise BrokerError("BROKER_PID_INVALID")
        return BrokerProcessIdentity(legacy_pid, None)
    if type(value) is int:
        if not 1 < value <= MAX_SIGNAL_PID:
            raise BrokerError("BROKER_PID_INVALID")
        return BrokerProcessIdentity(value, None)
    if not isinstance(value, dict) or set(value) not in (
        {"pid", "start_time"},
        {"pid", "start_time", "shutdown_capability"},
        {"pid", "start_time", "shutdown_capability", "profile_set_digest"},
    ):
        raise BrokerError("BROKER_PID_INVALID")
    pid = value["pid"]
    start_time = value["start_time"]
    if type(pid) is not int or not 1 < pid <= MAX_SIGNAL_PID:
        raise BrokerError("BROKER_PID_INVALID")
    if (
        not isinstance(start_time, str)
        or not start_time
        or len(start_time) > 128
        or start_time != " ".join(start_time.split())
    ):
        raise BrokerError("BROKER_PID_INVALID")
    shutdown_capability = value.get("shutdown_capability")
    if shutdown_capability is not None and (
        not isinstance(shutdown_capability, str)
        or not 32 <= len(shutdown_capability.encode("utf-8")) <= 4096
        or any(character in shutdown_capability for character in "\r\n\0")
    ):
        raise BrokerError("BROKER_PID_INVALID")
    profile_set_digest = value.get("profile_set_digest")
    if profile_set_digest is not None and (
        not isinstance(profile_set_digest, str)
        or re.fullmatch(r"[0-9a-f]{64}", profile_set_digest) is None
    ):
        raise BrokerError("BROKER_PID_INVALID")
    return BrokerProcessIdentity(
        pid, start_time, shutdown_capability, profile_set_digest
    )


def _read_broker_pid_entry(directory: int, name: str) -> BrokerProcessIdentity | None:
    raw = _read_private_entry(
        directory,
        name,
        "BROKER_PID_INVALID",
        minimum_bytes=1,
        maximum_bytes=256,
        missing_ok=True,
    )
    return None if raw is None else _parse_broker_pid(raw)


def _read_broker_pid(path: Path) -> BrokerProcessIdentity | None:
    raw = _read_private_file(
        path,
        "BROKER_PID_INVALID",
        minimum_bytes=1,
        maximum_bytes=256,
        missing_ok=True,
    )
    return None if raw is None else _parse_broker_pid(raw)


def _process_running(pid: int) -> bool:
    if type(pid) is not int or not 1 < pid <= MAX_SIGNAL_PID:
        raise BrokerError("BROKER_PID_INVALID")
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def _process_start_time(pid: int) -> str | None:
    return process_start_time(pid)


def _process_identity_matches(identity: BrokerProcessIdentity) -> bool:
    if identity.start_time is None or not _process_running(identity.pid):
        return False
    current = _process_start_time(identity.pid)
    return current is not None and hmac.compare_digest(current, identity.start_time)


class _ExactDrainChildSignalState:
    def __init__(self) -> None:
        self.forwarded = False


@contextmanager
def _operation_recovery_exact_child_signal_block():
    """Close the controller-signal race while the exact child is attached."""
    if threading.current_thread() is not threading.main_thread():
        raise OperationRecoveryError(
            "exact drain controller signal block is unavailable"
        )
    blocked = {signal.SIGINT, signal.SIGTERM}
    previous = signal.pthread_sigmask(signal.SIG_BLOCK, blocked)
    try:
        yield
    finally:
        signal.pthread_sigmask(signal.SIG_SETMASK, previous)


@contextmanager
def _operation_recovery_exact_child_signal_scope(
    process: subprocess.Popen[bytes],
    worker_start_time: str,
):
    """Forward controller interrupts to the authenticated exact child."""
    if threading.current_thread() is not threading.main_thread():
        raise OperationRecoveryError(
            "exact drain controller signal scope is unavailable"
        )
    state = _ExactDrainChildSignalState()
    previous = {
        signum: signal.getsignal(signum)
        for signum in (signal.SIGINT, signal.SIGTERM)
    }

    def forward(_signum, _frame) -> None:
        if (
            process.poll() is None
            and _process_identity_matches(
                BrokerProcessIdentity(process.pid, worker_start_time)
            )
        ):
            process.send_signal(signal.SIGTERM)
            state.forwarded = True
        raise OperationRecoveryError("exact drain controller was interrupted")

    try:
        for signum in previous:
            signal.signal(signum, forward)
        yield state
    finally:
        for signum, handler in previous.items():
            signal.signal(signum, handler)


def _terminate_broker_process(
    identity: BrokerProcessIdentity,
    socket_path: Path,
    *,
    timeout_seconds: float,
) -> None:
    if identity.start_time is None:
        raise BrokerError("BROKER_PID_IDENTITY_INVALID")
    pidfd_open = getattr(os, "pidfd_open", None)
    pidfd_send_signal = getattr(signal, "pidfd_send_signal", None)
    if pidfd_open is not None and pidfd_send_signal is not None:
        try:
            descriptor = pidfd_open(identity.pid)
        except ProcessLookupError:
            return
        except OSError as error:
            raise BrokerError("BROKER_PID_IDENTITY_INVALID") from error
        try:
            if not _process_identity_matches(identity):
                if not _process_running(identity.pid):
                    return
                raise BrokerError("BROKER_PID_IDENTITY_INVALID")
            try:
                pidfd_send_signal(descriptor, signal.SIGTERM)
            except ProcessLookupError:
                return
            except OSError as error:
                raise BrokerError("BROKER_PID_IDENTITY_INVALID") from error
        finally:
            os.close(descriptor)
        return
    # Platforms without pidfds must fail closed unless a stable start identity
    # is available and remains equal across two immediately adjacent reads.
    first = _process_start_time(identity.pid)
    second = _process_start_time(identity.pid)
    if (
        first is None
        or second is None
        or not hmac.compare_digest(first, identity.start_time)
        or not hmac.compare_digest(second, identity.start_time)
    ):
        if not _process_running(identity.pid):
            return
        raise BrokerError("BROKER_PID_IDENTITY_INVALID")
    try:
        client = JsonRpcClient(
            socket_path,
            timeout_seconds=max(0.001, min(timeout_seconds, 30.0)),
        )
        # Revalidate the recorded start identity immediately before the
        # shutdown mutation; client setup must not open a PID-reuse window.
        current = _process_start_time(identity.pid)
        if current is None or not hmac.compare_digest(current, identity.start_time):
            if not _process_running(identity.pid):
                return
            raise BrokerError("BROKER_PID_IDENTITY_INVALID")
        result = client.broker_shutdown(identity.shutdown_capability or "")
    except BrokerError as error:
        if error.code == "BROKER_PID_IDENTITY_INVALID":
            raise
        raise BrokerError("BROKER_SHUTDOWN_UNAVAILABLE") from error
    except OSError as error:
        raise BrokerError("BROKER_SHUTDOWN_UNAVAILABLE") from error
    if result != {"stopping": True}:
        raise BrokerError("BROKER_SHUTDOWN_UNAVAILABLE")


def _write_broker_pid(
    path: Path, shutdown_capability: str | None = None
) -> BrokerProcessIdentity:
    process_identity = BrokerProcessIdentity(
        os.getpid(), _process_start_time(os.getpid()), shutdown_capability
    )
    if process_identity.start_time is None:
        raise BrokerError("BROKER_PROCESS_IDENTITY_UNAVAILABLE")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags, 0o600)
    identity: tuple[int, int] | None = None
    try:
        metadata = os.fstat(descriptor)
        identity = (metadata.st_dev, metadata.st_ino)
        os.fchmod(descriptor, 0o600)
        value = canonical_bytes(
            {
                "pid": process_identity.pid,
                "start_time": process_identity.start_time,
                **(
                    {"shutdown_capability": shutdown_capability}
                    if shutdown_capability is not None
                    else {}
                ),
            }
        )
        offset = 0
        while offset < len(value):
            written = os.write(descriptor, value[offset:])
            if written <= 0 or written > len(value) - offset:
                raise OSError("short broker PID write")
            offset += written
        os.fsync(descriptor)
    except Exception:
        try:
            os.close(descriptor)
        except OSError:
            pass
        try:
            metadata = path.lstat()
            if identity is not None and identity == (metadata.st_dev, metadata.st_ino):
                path.unlink()
        except OSError:
            pass
        raise
    else:
        os.close(descriptor)
    return process_identity


def _write_broker_pid_entry(
    directory: int, name: str, shutdown_capability: str, profile_set_digest: str
) -> BrokerProcessIdentity:
    process_identity = BrokerProcessIdentity(
        os.getpid(),
        _process_start_time(os.getpid()),
        shutdown_capability,
        profile_set_digest,
    )
    if process_identity.start_time is None:
        raise BrokerError("BROKER_PROCESS_IDENTITY_UNAVAILABLE")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
    descriptor = os.open(name, flags, 0o600, dir_fd=directory)
    identity: tuple[int, int] | None = None
    try:
        metadata = os.fstat(descriptor)
        identity = metadata.st_dev, metadata.st_ino
        os.fchmod(descriptor, 0o600)
        value = canonical_bytes(
            {
                "pid": process_identity.pid,
                "start_time": process_identity.start_time,
                "shutdown_capability": shutdown_capability,
                "profile_set_digest": profile_set_digest,
            }
        )
        offset = 0
        while offset < len(value):
            written = os.write(descriptor, value[offset:])
            if written <= 0:
                raise OSError("short broker PID write")
            offset += written
        os.fsync(descriptor)
        os.fsync(directory)
    except Exception:
        try:
            current = os.stat(name, dir_fd=directory, follow_symlinks=False)
            if identity == (current.st_dev, current.st_ino):
                os.unlink(name, dir_fd=directory)
                os.fsync(directory)
        except OSError:
            pass
        raise
    finally:
        os.close(descriptor)
    return process_identity


def _broker_environment_resolver(name: str, label: str):
    if not isinstance(name, str) or ENVIRONMENT_NAME.fullmatch(name) is None:
        raise BrokerError(f"BROKER_{label}_RESOLVER_INVALID")

    def resolve() -> str:
        value = os.environ.get(name)
        if not isinstance(value, str) or not value or "\r" in value or "\n" in value:
            raise BrokerError(f"BROKER_{label}_UNAVAILABLE")
        return value

    return resolve


def _broker_runtime_configuration(
    args: argparse.Namespace, *, preflight_resolvers: bool = True
):
    try:
        inventory = load_inventory(args.inventory)
        integration_authority_digest = _broker_integration_authority_digest(
            args, inventory
        )
        token_resolver = _broker_environment_resolver(
            args.data_plane_token_env, "DATA_PLANE_TOKEN"
        )
        mint_authority_resolver = _broker_environment_resolver(
            args.mint_authority_env, "MINT_AUTHORITY"
        )
        # Fail closed before creating the socket or PID record. Resolvers remain
        # lazy afterward so rotation does not require broker reconstruction.
        if preflight_resolvers:
            token_value = token_resolver()
            mint_authority_value = mint_authority_resolver()
            if hmac.compare_digest(
                token_value.encode("utf-8"),
                mint_authority_value.encode("utf-8"),
            ):
                raise BrokerError("BROKER_RUNTIME_CREDENTIAL_SEPARATION_INVALID")
        return compile_runtime_configuration(
            inventory=inventory,
            profiles=tuple(args.profile),
            token_resolver=token_resolver,
            mint_authority_resolver=mint_authority_resolver,
            token_resolver_id=args.data_plane_token_env,
            mint_authority_resolver_id=args.mint_authority_env,
            integration_authority_digest=integration_authority_digest,
            verify_adapters=preflight_resolvers,
        )
    except (
        InventoryError,
        RuntimeConfigurationError,
        AdapterError,
        IntegrationUpgradeError,
    ) as error:
        raise BrokerError("BROKER_RUNTIME_CONFIGURATION_INVALID") from error


def _broker_integration_authority_digest(
    args: argparse.Namespace, inventory: Any
) -> str | None:
    state_dir = getattr(args, "integration_upgrade_state", None)
    if state_dir is None:
        return None
    selected_profiles = set(args.profile)
    harness_ids = tuple(
        harness["id"]
        for harness in inventory.harnesses
        if harness["profile_id"] in selected_profiles
    )
    return read_integration_authority_set_digest(state_dir, harness_ids)


def _broker_binding_mode_error(inactive: bool, bindings: tuple[Any, ...]) -> str | None:
    if inactive and any(bindings):
        return "inactive-with-bindings"
    if not inactive and not all(bindings):
        return "active-missing-bindings"
    return None


def _broker_runtime_bindings(args: argparse.Namespace):
    # Command functions are also a tested programmatic interface. Older
    # callers construct a minimal Namespace without the parser's runtime
    # fields; keep that explicit transitional shape inactive.
    inactive = getattr(args, "inactive", True)
    bindings = (
        getattr(args, "inventory", None),
        getattr(args, "data_plane_token_env", None),
        getattr(args, "mint_authority_env", None),
    )
    if inactive and getattr(args, "integration_upgrade_state", None):
        raise BrokerError("BROKER_RUNTIME_CONFIGURATION_INVALID")
    binding_error = _broker_binding_mode_error(inactive, bindings)
    if binding_error == "inactive-with-bindings":
        raise BrokerError("BROKER_RUNTIME_CONFIGURATION_INVALID")
    if inactive:
        return None
    if binding_error == "active-missing-bindings":
        raise BrokerError("BROKER_RUNTIME_CONFIGURATION_REQUIRED")
    return bindings


def _broker_selected_runtime(args: argparse.Namespace, *, preflight_resolvers: bool):
    if _broker_runtime_bindings(args) is None:
        return None
    return _broker_runtime_configuration(args, preflight_resolvers=preflight_resolvers)


def _broker_selected_runtime_status(args: argparse.Namespace):
    if _broker_runtime_bindings(args) is None:
        return None
    try:
        inventory = load_inventory(args.inventory)
        integration_authority_digest = _broker_integration_authority_digest(
            args, inventory
        )
        return compile_runtime_status(
            inventory=inventory,
            profiles=tuple(args.profile),
            token_resolver_id=args.data_plane_token_env,
            mint_authority_resolver_id=args.mint_authority_env,
            integration_authority_digest=integration_authority_digest,
        )
    except (
        InventoryError,
        RuntimeConfigurationError,
        IntegrationUpgradeError,
    ) as error:
        raise BrokerError("BROKER_RUNTIME_CONFIGURATION_INVALID") from error


def _inactive_broker_policy_digest(profiles: list[str]) -> str:
    return digest(
        {
            "mode": "inactive",
            "profiles": sorted(set(profiles)),
        }
    )


def broker_serve_command(args: argparse.Namespace) -> int:
    shutdown_timeout = _bounded_broker_timeout(args.shutdown_timeout)
    state_dir, socket_path, pid_path = _broker_paths(args)
    _private_broker_state(state_dir)
    key: bytes | None = None
    runtime = _broker_selected_runtime(args, preflight_resolvers=True)
    policy_digest = (
        runtime.policy_digest
        if runtime is not None
        else _inactive_broker_policy_digest(args.profile)
    )
    artifact_digest = (
        runtime.artifact_digest
        if runtime is not None
        else digest({"broker_schema_version": 1, "routes": []})
    )
    process_digest = (
        runtime.profile_set_digest if runtime is not None else policy_digest
    )
    stopped = threading.Event()
    shutdown_capability = secrets.token_urlsafe(32)

    def stop(_signum: int, _frame: Any) -> None:
        stopped.set()

    previous = {
        signum: signal.signal(signum, stop)
        for signum in (signal.SIGINT, signal.SIGTERM)
    }
    broker_identity: BrokerProcessIdentity | None = None
    broker: Broker | None = None
    server: UnixJsonRpcServer | None = None
    shutdown = {
        "undrained": 0,
        "active_reads": 0,
        "active_writes": 0,
        "retired": False,
        "retirement_pending": False,
    }
    try:
        with _broker_lifecycle_lock(state_dir) as directory:
            if not _broker_state_directory_matches(state_dir, directory):
                raise BrokerError("BROKER_PATH_INVALID")
            key = _broker_signing_key(state_dir)
            if not _broker_state_directory_matches(state_dir, directory):
                raise BrokerError("BROKER_PATH_INVALID")
            existing_identity = _read_broker_pid_entry(directory, pid_path.name)
            if existing_identity is not None:
                if _process_running(existing_identity.pid):
                    if _process_identity_matches(existing_identity):
                        raise BrokerError("BROKER_ALREADY_RUNNING")
                    if _process_running(existing_identity.pid):
                        raise BrokerError("BROKER_PID_IDENTITY_INVALID")
                if (
                    _read_broker_pid_entry(directory, pid_path.name)
                    == existing_identity
                ):
                    if _process_running(existing_identity.pid):
                        if _process_identity_matches(existing_identity):
                            raise BrokerError("BROKER_ALREADY_RUNNING")
                        raise BrokerError("BROKER_PID_IDENTITY_INVALID")
                    os.unlink(pid_path.name, dir_fd=directory)
                    os.fsync(directory)
            if socket_path.exists() or socket_path.is_symlink():
                if not _broker_state_directory_matches(state_dir, directory):
                    raise BrokerError("BROKER_PATH_INVALID")
                if _broker_probe(socket_path):
                    raise BrokerError("BROKER_ALREADY_RUNNING")
                if _broker_probe(socket_path):
                    raise BrokerError("BROKER_ALREADY_RUNNING")
                _remove_broker_socket_entry(directory, socket_path.name)
            assert key is not None
            broker = Broker(
                state_dir=state_dir,
                signing_key=key,
                routes=runtime.routes if runtime is not None else {},
                policy_digest=policy_digest,
                artifact_digest=artifact_digest,
                mint_authorizer=(
                    runtime.mint_authorizer
                    if runtime is not None
                    else lambda _control, _claims, _ttl: {}
                ),
            )
            server = UnixJsonRpcServer(
                socket_path,
                broker,
                shutdown_callback=stopped.set,
                shutdown_capability=shutdown_capability,
            )
            if not _broker_state_directory_matches(state_dir, directory):
                raise BrokerError("BROKER_PATH_INVALID")
            server.start()
            if not _broker_state_directory_matches(state_dir, directory):
                server.close()
                raise BrokerError("BROKER_PATH_INVALID")
            broker_identity = _write_broker_pid_entry(
                directory, pid_path.name, shutdown_capability, process_digest
            )
        ready = (
            {"broker": "ready", **dict(runtime.status)}
            if runtime is not None
            else {
                "broker": "ready",
                "mode": "inactive",
                "profiles": sorted(set(args.profile)),
            }
        )
        print(json.dumps(ready, sort_keys=True), flush=True)
        while not stopped.wait(0.25):
            pass
    finally:
        with _broker_lifecycle_lock(state_dir) as directory:
            close_error: Exception | None = None
            shutdown_error: Exception | None = None
            if server is not None:
                try:
                    server.close()
                except Exception as error:
                    close_error = (
                        error
                        if isinstance(error, BrokerError)
                        else BrokerError("BROKER_SERVER_CLOSE_FAILED")
                    )
            if broker is not None:
                try:
                    shutdown = broker.shutdown(timeout_seconds=shutdown_timeout)
                except Exception as error:
                    shutdown_error = error
        for signum, handler in previous.items():
            signal.signal(signum, handler)
        if close_error is not None:
            raise close_error
        if shutdown_error is not None:
            raise shutdown_error
    if (
        shutdown["undrained"]
        or shutdown["active_reads"]
        or shutdown["active_writes"]
        or shutdown["retirement_pending"]
    ):
        raise BrokerError("BROKER_SHUTDOWN_INCOMPLETE")
    try:
        with _broker_lifecycle_lock(state_dir) as directory:
            if (
                broker_identity is not None
                and _read_broker_pid_entry(directory, pid_path.name) == broker_identity
            ):
                os.unlink(pid_path.name, dir_fd=directory)
                os.fsync(directory)
    except BrokerError:
        raise
    except Exception as error:
        raise BrokerError("BROKER_PID_CLEANUP_FAILED") from error
    return 0


def broker_status_command(args: argparse.Namespace) -> int:
    state_dir, socket_path, pid_path = _broker_paths(args)
    if not _private_broker_state(state_dir, create=False):
        raise BrokerError("BROKER_UNAVAILABLE")
    runtime_status = _broker_selected_runtime_status(args)
    expected_profile_set_digest = (
        runtime_status["profile_set_digest"]
        if runtime_status is not None
        else _inactive_broker_policy_digest(args.profile)
    )
    identity = _read_broker_pid(pid_path)
    if identity is None:
        raise BrokerError("BROKER_UNAVAILABLE")
    if not hmac.compare_digest(
        identity.profile_set_digest or "", expected_profile_set_digest
    ):
        raise BrokerError("BROKER_PROFILE_SET_MISMATCH")
    if (
        not _process_identity_matches(identity)
        or not _broker_probe(socket_path, expected_pid=identity.pid)
        or _read_broker_pid(pid_path) != identity
        or not _process_identity_matches(identity)
    ):
        raise BrokerError("BROKER_UNAVAILABLE")
    status = (
        {
            "broker": "healthy",
            "socket": str(socket_path),
            **dict(runtime_status),
        }
        if runtime_status is not None
        else {"broker": "healthy", "mode": "inactive", "socket": str(socket_path)}
    )
    print(json.dumps(status, sort_keys=True))
    return 0


def broker_stop_command(args: argparse.Namespace) -> int:
    timeout = _bounded_broker_timeout(args.timeout)
    deadline = time.monotonic() + timeout
    state_dir, socket_path, pid_path = _broker_paths(args)
    if not _private_broker_state(state_dir, create=False):
        return 0
    with _broker_lifecycle_lock(state_dir, deadline=deadline) as directory:
        if not _broker_state_directory_matches(state_dir, directory):
            raise BrokerError("BROKER_PATH_INVALID")
        identity = _read_broker_pid_entry(directory, pid_path.name)
        if identity is None:
            if _broker_probe(socket_path):
                raise BrokerError("BROKER_PID_INVALID")
            if _broker_probe(socket_path):
                raise BrokerError("BROKER_PID_INVALID")
            _remove_broker_socket_entry(directory, socket_path.name)
            return 0
        if _process_running(identity.pid):
            if _process_identity_matches(identity):
                _terminate_broker_process(
                    identity,
                    socket_path,
                    timeout_seconds=max(0.001, deadline - time.monotonic()),
                )
            elif _process_running(identity.pid):
                raise BrokerError("BROKER_PID_IDENTITY_INVALID")
    while True:
        remaining = max(0.0, deadline - time.monotonic())
        probe_timeout = min(0.1, max(0.001, remaining))
        if not _process_identity_matches(identity) and not _broker_probe(
            socket_path,
            timeout=probe_timeout,
            expected_pid=identity.pid,
        ):
            with _broker_lifecycle_lock(state_dir, deadline=deadline) as directory:
                if not _broker_state_directory_matches(state_dir, directory):
                    raise BrokerError("BROKER_PATH_INVALID")
                if _process_identity_matches(identity) or _broker_probe(
                    socket_path,
                    timeout=probe_timeout,
                    expected_pid=identity.pid,
                ):
                    continue
                current_identity = _read_broker_pid_entry(directory, pid_path.name)
                if current_identity == identity:
                    if _broker_probe(socket_path, timeout=probe_timeout):
                        raise BrokerError("BROKER_PID_INVALID")
                    _remove_broker_socket_entry(directory, socket_path.name)
                    os.unlink(pid_path.name, dir_fd=directory)
                    os.fsync(directory)
                return 0
        if time.monotonic() >= deadline:
            break
        time.sleep(min(0.05, max(0.0, deadline - time.monotonic())))
    raise BrokerError("BROKER_STOP_TIMEOUT")


def _required_environment(name: str, code: str) -> str:
    if not isinstance(name, str) or ENVIRONMENT_NAME.fullmatch(name) is None:
        raise BrokerError(code)
    value = os.environ.get(name)
    if not value:
        raise BrokerError(code)
    return value


def _request_object(path: str, label: str) -> dict[str, Any]:
    value = read_json(path)
    if not isinstance(value, dict):
        raise BrokerError(f"{label}_INVALID")
    return value


def _print_result(value: Any) -> int:
    if not isinstance(value, dict):
        raise BrokerError("RESPONSE_INVALID")
    print(json.dumps(value, sort_keys=True, separators=(",", ":")))
    return 0


def _json_rpc_client(args: argparse.Namespace) -> JsonRpcClient:
    state_dir, socket_path, pid_path = _broker_paths(args)
    timeout = _bounded_broker_timeout(args.timeout)
    deadline = time.monotonic() + timeout
    if not _private_broker_state(state_dir, create=False):
        raise BrokerError("BROKER_UNAVAILABLE")
    with _broker_lifecycle_lock(state_dir, deadline=deadline) as directory:
        if not _broker_state_directory_matches(state_dir, directory):
            raise BrokerError("BROKER_PATH_INVALID")
        identity = _read_broker_pid_entry(directory, pid_path.name)
        if (
            identity is None
            or not _process_identity_matches(identity)
            or not _broker_probe(
                socket_path,
                timeout=max(0.001, deadline - time.monotonic()),
                expected_pid=identity.pid,
            )
            or _read_broker_pid_entry(directory, pid_path.name) != identity
            or not _process_identity_matches(identity)
        ):
            raise BrokerError("BROKER_PID_IDENTITY_INVALID")
        return JsonRpcClient(socket_path, timeout_seconds=timeout)


def session_mint_command(args: argparse.Namespace) -> int:
    return _print_result(
        _json_rpc_client(args).session_mint(
            _required_environment(
                args.control_capability_env, "CONTROL_CAPABILITY_UNAVAILABLE"
            ),
            _request_object(args.request, "MINT_REQUEST"),
            ttl_seconds=args.ttl_seconds,
        )
    )


def session_exchange_command(args: argparse.Namespace) -> int:
    return _print_result(
        _json_rpc_client(args).session_exchange(
            _required_environment(args.handle_env, "SESSION_HANDLE_UNAVAILABLE")
        )
    )


def _session_capability(args: argparse.Namespace) -> str:
    return _required_environment(args.capability_env, "SESSION_CAPABILITY_UNAVAILABLE")


def session_close_command(args: argparse.Namespace) -> int:
    return _print_result(
        _json_rpc_client(args).session_close(
            _session_capability(args),
            sequence=args.sequence,
            action_id=args.action_id,
            timeout_seconds=args.timeout,
        )
    )


def broker_method_command(args: argparse.Namespace) -> int:
    client = _json_rpc_client(args)
    capability = _session_capability(args)
    method = args.rpc_method
    common = {
        "sequence": args.sequence,
        "action_id": args.action_id,
    }
    if method == "session_status":
        result = client.session_status(
            capability, timeout_seconds=args.timeout, **common
        )
    else:
        request = _request_object(args.request, "REQUEST")
        target = getattr(client, method)
        if method in {"recall", "mental_model_fetch", "reflect"}:
            result = target(
                capability, request=request, timeout_seconds=args.timeout, **common
            )
        else:
            result = target(capability, request=request, **common)
    return _print_result(result)


def _read_bridge_handle(descriptor: int) -> str:
    if type(descriptor) is not int or descriptor < 3:
        raise BridgeError("HANDLE_FD_INVALID")
    chunks = bytearray()
    try:
        while True:
            chunk = os.read(descriptor, 65 - len(chunks))
            if not chunk:
                break
            chunks.extend(chunk)
            if len(chunks) > 64:
                raise BridgeError("HANDLE_INVALID")
    finally:
        os.close(descriptor)
    try:
        handle = chunks.decode("ascii")
    except UnicodeDecodeError as error:
        raise BridgeError("HANDLE_INVALID") from error
    if re.fullmatch(r"[0-9a-f]{64}", handle) is None:
        raise BridgeError("HANDLE_INVALID")
    return handle


def bridge_serve_command(args: argparse.Namespace) -> int:
    bridge = SessionBridge(
        broker_client=JsonRpcClient(args.broker_socket),
        handle=_read_bridge_handle(args.handle_fd),
        session_id=args.session_id,
        harness_id=args.harness,
    )
    server = UnixBridgeServer(
        args.socket, bridge, lifetime_seconds=args.lifetime_seconds
    )
    server.start()
    idle = threading.Event()
    try:
        while server.running:
            idle.wait(0.05)
    finally:
        server.close()
    return 0


def _native_hook_payload() -> dict[str, Any]:
    raw = sys.stdin.buffer.read(MAX_BRIDGE_INPUT_BYTES + 1)
    if len(raw) > MAX_BRIDGE_INPUT_BYTES:
        raise BridgeError("INPUT_INVALID")
    try:
        value = strict_json_loads(raw.decode("utf-8"))
    except (StrictJsonError, UnicodeDecodeError) as error:
        raise BridgeError("INPUT_INVALID") from error
    if not isinstance(value, dict):
        raise BridgeError("INPUT_INVALID")
    return value


def _native_session_id(harness_id: str, payload: Mapping[str, Any]) -> str:
    if harness_id == "cursor":
        conversation_id = payload.get("conversation_id")
        native_session_id = payload.get("session_id")
        if (
            conversation_id is not None
            and native_session_id is not None
            and conversation_id != native_session_id
        ):
            raise BridgeError("SESSION_MISMATCH")
        value = conversation_id or native_session_id
    else:
        value = payload.get("session_id")
    if not isinstance(value, str):
        raise BridgeError("SESSION_INVALID")
    return value


def _activate_gui_envelope(
    args: argparse.Namespace, *, session_id: str
) -> Path:
    with consume_gui_envelope(
        args.locator_dir,
        session_id=session_id,
        harness_id=args.harness_id,
    ) as envelope:
        handle = envelope["handle"]
        broker_socket = Path(envelope["broker_socket"])
        process: subprocess.Popen[bytes] | None = None
        try:
            if envelope["expires_at"] <= time.time():
                raise BridgeError("ENVELOPE_EXPIRED")
            bridge_dir = Path(envelope["bridge_dir"])
            socket_path = allocate_bridge_socket(
                bridge_dir,
                session_id=session_id,
                harness_id=args.harness_id,
            )
            process = start_bridge_process(
                executable=str(Path(__file__).resolve()),
                python_executable=sys.executable,
                state_dir=Path(envelope["state_dir"]),
                bridge_socket=socket_path,
                broker_socket=broker_socket,
                handle=handle,
                session_id=session_id,
                harness_id=args.harness_id,
                detached=True,
                lifetime_seconds=envelope["expires_at"] - time.time(),
                environment=sanitized_harness_environment(
                    os.environ, socket_path
                ),
            )
            wait_for_bridge(socket_path, process, timeout=args.timeout)
            write_bridge_locator(
                args.locator_dir,
                session_id=session_id,
                harness_id=args.harness_id,
                socket_path=socket_path,
            )
            return socket_path
        except Exception as activation_error:
            if process is not None:
                try:
                    _terminate_bridge_process(process)
                except Exception:
                    pass
            try:
                _cancel_minted_session(
                    JsonRpcClient(broker_socket),
                    handle,
                    action_id="gui-envelope-cancel",
                )
            except Exception as cleanup_error:
                raise BridgeError("MINT_CLEANUP_FAILED") from cleanup_error
            raise activation_error


def harness_command(args: argparse.Namespace) -> int:
    if args.event in {"launch", "stage-gui"}:
        return harness_launch_command(args)
    failure_isolated = args.event in {
        "recall",
        "session-start",
        "checkpoint",
        "pre-compact",
        "close",
        "tool-recall",
        "reflect",
        "model",
        "status",
    }
    try:
        payload = _native_hook_payload()
        if args.bridge is not None:
            locator = Path(args.bridge)
        else:
            environment_locator = os.environ.get(args.bridge_env)
            if environment_locator:
                locator = Path(environment_locator)
            elif args.locator_dir:
                session_id = _native_session_id(args.harness_id, payload)
                try:
                    locator = read_bridge_locator(
                        args.locator_dir,
                        session_id=session_id,
                        harness_id=args.harness_id,
                    )
                except BridgeError as error:
                    if error.code != "LOCATOR_UNAVAILABLE":
                        raise
                    locator = _activate_gui_envelope(args, session_id=session_id)
            else:
                raise BridgeError("BRIDGE_UNAVAILABLE")
        client = JsonBridgeClient(locator, timeout=args.timeout)
        try:
            result = client.call_native(args.harness_id, args.event, payload)
        except BridgeError as error:
            if (
                error.code != "BRIDGE_UNAVAILABLE"
                or not args.locator_dir
                or args.bridge is not None
            ):
                raise
            remove_bridge_locator(
                args.locator_dir,
                session_id=_native_session_id(args.harness_id, payload),
                harness_id=args.harness_id,
                expected_socket=locator,
            )
            locator = _activate_gui_envelope(
                args,
                session_id=_native_session_id(args.harness_id, payload),
            )
            result = JsonBridgeClient(locator, timeout=args.timeout).call_native(
                args.harness_id, args.event, payload
            )
    except BridgeError as error:
        print(f"[Hindsight] {error.code}", file=sys.stderr)
        return 0 if failure_isolated else 2
    if args.event == "close":
        _report_close_result(result)
        if args.locator_dir:
            try:
                remove_bridge_locator(
                    args.locator_dir,
                    session_id=_native_session_id(args.harness_id, payload),
                    harness_id=args.harness_id,
                    expected_socket=locator,
                )
            except BridgeError as error:
                print(f"[Hindsight] {error.code}", file=sys.stderr)
    if result:
        print(json.dumps(result, sort_keys=True, separators=(",", ":")))
    return 0


def _cancel_minted_session(
    broker_client: JsonRpcClient, handle: str, *, action_id: str
) -> None:
    exchanged = broker_client.session_exchange(handle)
    exchange_payload = exchanged.get("payload")
    capability = (
        exchange_payload.get("capability")
        if isinstance(exchange_payload, Mapping)
        else None
    )
    if not isinstance(capability, str):
        raise BridgeError("MINT_CLEANUP_FAILED")
    broker_client.session_close(
        capability,
        sequence=1,
        action_id=action_id,
        timeout_seconds=2,
    )


def _mint_harness_session(
    args: argparse.Namespace,
) -> tuple[JsonRpcClient, str, float]:
    if not all(
        isinstance(value, str) and value
        for value in (
            args.broker_socket,
            args.session_id,
            args.companion_id,
            args.route,
            args.bridge_dir,
        )
    ):
        raise BridgeError("LAUNCH_ARGUMENTS_INVALID")
    control_capability = _required_environment(
        args.control_capability_env, "CONTROL_CAPABILITY_UNAVAILABLE"
    )
    broker_client = JsonRpcClient(args.broker_socket)
    response = broker_client.session_mint(
        control_capability,
        {
            "session_id": args.session_id,
            "companion_id": args.companion_id,
            "route": args.route,
        },
        ttl_seconds=args.ttl_seconds,
    )
    payload = response.get("payload") if isinstance(response, Mapping) else None
    handle = payload.get("handle") if isinstance(payload, Mapping) else None
    expires_at = payload.get("expires_at") if isinstance(payload, Mapping) else None
    if (
        not isinstance(handle, str)
        or type(expires_at) not in {int, float}
        or expires_at <= time.time()
    ):
        raise BridgeError("MINT_FAILED")
    return broker_client, handle, float(expires_at)


def _start_harness_bridge(
    args: argparse.Namespace, *, detached: bool
) -> tuple[subprocess.Popen[bytes], Path, str]:
    broker_client, handle, expires_at = _mint_harness_session(args)
    process: subprocess.Popen[bytes] | None = None
    try:
        bridge_dir = Path(args.bridge_dir)
        if not bridge_dir.exists():
            bridge_dir.mkdir(mode=0o700)
        socket_path = allocate_bridge_socket(
            bridge_dir,
            session_id=args.session_id,
            harness_id=args.harness_id,
        )
        process = start_bridge_process(
            executable=str(Path(__file__).resolve()),
            python_executable=sys.executable,
            state_dir=Path(args.state_dir).resolve(),
            bridge_socket=socket_path,
            broker_socket=Path(args.broker_socket).resolve(),
            handle=handle,
            session_id=args.session_id,
            harness_id=args.harness_id,
            detached=detached,
            lifetime_seconds=expires_at - time.time(),
            environment={
                key: value
                for key, value in os.environ.items()
                if key != args.control_capability_env
            },
        )
        wait_for_bridge(socket_path, process, timeout=args.timeout)
    except Exception as start_error:
        termination_error = None
        if process is not None:
            try:
                _terminate_bridge_process(process)
            except Exception as error:
                termination_error = error
        try:
            _cancel_minted_session(
                broker_client,
                handle,
                action_id="launcher-startup-cancel",
            )
        except Exception as cleanup_error:
            raise BridgeError("MINT_CLEANUP_FAILED") from cleanup_error
        if termination_error is not None:
            raise BridgeError("BRIDGE_SHUTDOWN_FAILED") from termination_error
        raise start_error
    return process, socket_path, handle


def _terminate_bridge_process(process: subprocess.Popen[bytes]) -> None:
    """Stop a bridge with bounded escalation and a reaped child."""

    process.terminate()
    try:
        process.wait(timeout=2)
        return
    except subprocess.TimeoutExpired:
        process.kill()
    try:
        process.wait(timeout=2)
    except subprocess.TimeoutExpired as error:
        raise BridgeError("BRIDGE_SHUTDOWN_FAILED") from error


def _report_close_result(result: Mapping[str, Any]) -> None:
    checkpoint = result.get("checkpoint")
    if isinstance(checkpoint, Mapping):
        diagnostic = checkpoint.get("diagnostic")
        code = diagnostic.get("code") if isinstance(diagnostic, Mapping) else None
        if isinstance(code, str):
            print(f"[Hindsight] final checkpoint: {code}", file=sys.stderr)
    close_payload = result.get("payload")
    if isinstance(close_payload, Mapping):
        undrained = close_payload.get("undrained")
        write_drain = close_payload.get("write_drain")
        if undrained != 0 or write_drain != "drained":
            print(
                "[Hindsight] bridge closed with undrained writes: "
                f"count={undrained!r}, state={write_drain!r}",
                file=sys.stderr,
            )


def harness_launch_command(args: argparse.Namespace) -> int:
    detached = args.event == "stage-gui"
    if detached and not args.locator_dir:
        raise BridgeError("LAUNCH_ARGUMENTS_INVALID")
    command = list(args.launch_command or [])
    if command and command[0] == "--":
        command.pop(0)
    if not detached and (
        not command or any(not isinstance(item, str) or not item for item in command)
    ):
        raise BridgeError("LAUNCH_ARGUMENTS_INVALID")
    if detached:
        reservation = reserve_gui_envelope_slot(
            args.locator_dir, session_id=args.session_id
        )
        try:
            broker_client, handle, expires_at = _mint_harness_session(args)
            try:
                envelope = write_gui_envelope(
                    args.locator_dir,
                    session_id=args.session_id,
                    harness_id=args.harness_id,
                    handle=handle,
                    state_dir=Path(args.state_dir).resolve(),
                    broker_socket=Path(args.broker_socket).resolve(),
                    bridge_dir=Path(args.bridge_dir).resolve(),
                    expires_at=expires_at,
                )
            except Exception as publication_error:
                try:
                    _cancel_minted_session(
                        broker_client,
                        handle,
                        action_id="launcher-publication-cancel",
                    )
                except Exception as cleanup_error:
                    raise BridgeError("MINT_CLEANUP_FAILED") from cleanup_error
                raise publication_error
        finally:
            release_gui_envelope_slot(reservation)
        print(json.dumps({"status": "staged", "envelope": str(envelope)}))
        return 0
    process, socket_path, _handle = _start_harness_bridge(args, detached=False)
    environment = sanitized_harness_environment(
        {
            key: value
            for key, value in os.environ.items()
            if key != args.control_capability_env
        },
        socket_path,
    )
    try:
        completed = subprocess.run(command, env=environment, check=False)
    finally:
        try:
            close_result = JsonBridgeClient(socket_path, timeout=2).call_native(
                args.harness_id,
                "close",
                {"session_id": args.session_id},
            )
            _report_close_result(close_result)
        except BridgeError as error:
            print(f"[Hindsight] bridge close: {error.code}", file=sys.stderr)
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            _terminate_bridge_process(process)
    return completed.returncode


def _harness_destination(args: argparse.Namespace) -> NativeHarnessDestination:
    try:
        return NativeHarnessDestination.load(read_json(args.destination))
    except (TypeError, ValueError) as error:
        raise HarnessPersistenceError("harness destination is invalid") from error


def _harness_artifact(args: argparse.Namespace, harness_id: str):
    if not args.state_dir:
        raise HarnessPersistenceError("harness activation requires --state-dir")
    try:
        return render_native_harness_artifact(
            harness_id,
            executable=args.executable,
            state_dir=args.state_dir,
            locator_dir=args.locator_dir,
        )
    except (TypeError, ValueError) as error:
        raise HarnessPersistenceError("harness artifact binding is invalid") from error


def _require_canonical_engineering_routes(inventory: Any, harness_id: str) -> None:
    declared = {
        harness["id"]: harness
        for harness in inventory.harnesses
        if harness.get("id") in SUPPORTED_NATIVE_HARNESSES
    }
    if harness_id not in declared:
        raise HarnessPersistenceError(
            f"harness {harness_id} is not declared in the validated inventory"
        )
    for selected_id, harness in declared.items():
        for route in ("home_bank", "write_bank"):
            bank = harness.get(route)
            if (
                not isinstance(bank, Mapping)
                or bank.get("bank_id") != "engineering"
            ):
                raise HarnessPersistenceError(
                    f"harness {selected_id} {route} must route to engineering"
                )


def _harness_activation_record(
    destination: NativeHarnessDestination, receipt: Mapping[str, Any]
) -> dict[str, Any]:
    body = {
        "schema_version": 1,
        "destination": destination.to_record(),
        "destination_digest": destination.destination_digest,
        "plan": deep_thaw(receipt),
    }
    return {**body, "approval_digest": digest(body)}


def _load_harness_activation_record(
    path: str | Path,
) -> tuple[Mapping[str, Any], Mapping[str, Any]]:
    record = read_json(path)
    if not isinstance(record, Mapping) or set(record) != {
        "schema_version",
        "destination",
        "destination_digest",
        "plan",
        "approval_digest",
    }:
        raise HarnessPersistenceError("harness activation record is invalid")
    body = {key: value for key, value in record.items() if key != "approval_digest"}
    if (
        type(record.get("schema_version")) is not int
        or record["schema_version"] != 1
        or not isinstance(record.get("destination"), Mapping)
        or not isinstance(record.get("destination_digest"), str)
        or not isinstance(record.get("plan"), Mapping)
        or not isinstance(record.get("approval_digest"), str)
        or digest(record["destination"]) != record["destination_digest"]
        or not hmac.compare_digest(digest(body), record["approval_digest"])
    ):
        raise HarnessPersistenceError("harness activation record is invalid")
    try:
        receipt = load_native_activation_receipt(record["plan"])
    except (TypeError, ValueError) as error:
        raise HarnessPersistenceError("harness activation record is invalid") from error
    return record, receipt


def _reconstruct_harness_activation_plan(
    args: argparse.Namespace,
    receipt: Mapping[str, Any],
    prestate: Mapping[str, Any],
) -> NativeActivationPlan:
    try:
        staged = verify_native_harness_generation(args.generation)
        artifact = staged.get(receipt["harness_id"])
        if artifact is None:
            raise ValueError("staged generation does not contain harness")
        inventory = load_inventory(args.inventory)
        _require_canonical_engineering_routes(inventory, receipt["harness_id"])
        policy_digest = digest(read_json(args.policy))
        plan = native_activation_plan(
            artifact,
            prestate,
            staged_generation=args.generation,
            upstream_integration_roots=tuple(args.upstream_integration_root or ()),
            inventory_digest=inventory.inventory_digest,
            artifact_digest=inventory.artifact_digest,
            policy_digest=policy_digest,
        )
    except (InventoryError, StrictJsonError, TypeError, ValueError) as error:
        raise HarnessPersistenceError("harness activation plan cannot be reconstructed") from error
    if plan.to_dict() != receipt:
        raise HarnessPersistenceError("harness activation inputs changed")
    return plan


def _validate_activation_record(
    destination: NativeHarnessDestination,
    record: Mapping[str, Any],
    receipt: Mapping[str, Any],
    approval_digest: str,
) -> None:
    if (
        receipt["harness_id"] != destination.harness_id
        or record["destination"] != destination.to_record()
        or record["destination_digest"] != destination.destination_digest
    ):
        raise HarnessPersistenceError("activation plan destination changed")
    if not hmac.compare_digest(approval_digest, record["approval_digest"]):
        raise HarnessPersistenceError("harness activation record is not approved")


def harness_config_stage_command(args: argparse.Namespace) -> int:
    destination = _harness_destination(args)
    artifact = _harness_artifact(args, destination.harness_id)
    try:
        generation = stage_native_harness_artifacts(
            args.staging_root, {destination.harness_id: artifact}
        )
    except (TypeError, ValueError) as error:
        raise HarnessPersistenceError("harness artifact staging failed") from error
    print(
        json.dumps(
            {
                "schema_version": 1,
                "harness_id": destination.harness_id,
                "generation": str(generation),
                "generation_digest": generation.name,
                "native_artifact_digest": artifact.artifact_digest,
            },
            sort_keys=True,
        )
    )
    return 0


def harness_config_plan_command(args: argparse.Namespace) -> int:
    destination = _harness_destination(args)
    artifact = _harness_artifact(args, destination.harness_id)
    try:
        staged = verify_native_harness_generation(args.generation)
    except (TypeError, ValueError) as error:
        raise HarnessPersistenceError("staged harness generation is invalid") from error
    if destination.harness_id not in staged:
        raise HarnessPersistenceError("staged generation does not contain destination")
    staged_artifact = staged[destination.harness_id]
    if not hmac.compare_digest(
        artifact.artifact_digest, staged_artifact.artifact_digest
    ):
        raise HarnessPersistenceError("staged harness artifact binding changed")
    inventory = load_inventory(args.inventory)
    _require_canonical_engineering_routes(inventory, destination.harness_id)
    policy_digest = digest(read_json(args.policy))
    try:
        plan = native_activation_plan(
            staged_artifact,
            destination.read_configuration(),
            staged_generation=args.generation,
            upstream_integration_roots=tuple(args.upstream_integration_root or ()),
            inventory_digest=inventory.inventory_digest,
            artifact_digest=inventory.artifact_digest,
            policy_digest=policy_digest,
        )
    except (TypeError, ValueError) as error:
        raise HarnessPersistenceError("harness activation plan is invalid") from error
    receipt = plan.to_dict()
    record = _harness_activation_record(destination, receipt)
    write_private(args.output, record)
    print(
        json.dumps(
            {
                "schema_version": 1,
                "harness_id": destination.harness_id,
                "plan": str(Path(args.output).resolve()),
                "approval_digest": record["approval_digest"],
                "destination_digest": destination.destination_digest,
                "plan_digest": plan.plan_digest,
                "target_digest": plan.target_digest,
            },
            sort_keys=True,
        )
    )
    return 0


def harness_config_apply_command(args: argparse.Namespace) -> int:
    destination = _harness_destination(args)
    record, receipt = _load_harness_activation_record(args.plan)
    _validate_activation_record(
        destination, record, receipt, args.approval_digest
    )
    current = destination.read_configuration()
    plan = _reconstruct_harness_activation_plan(args, receipt, current)
    outcome = apply_native_activation(
        plan,
        current,
        staged_generation=args.generation,
        approved_plan_digest=plan.plan_digest,
        inventory_digest=plan.inventory_digest,
        artifact_digest=plan.artifact_digest,
        policy_digest=plan.policy_digest,
        broker_healthy=args.broker_healthy,
        profile_healthy=args.profile_healthy,
        adapter_self_test=args.adapter_self_test,
        persist_rollback=destination.persist_rollback,
        read_rollback=lambda: destination.read_rollback(
            plan.expected_prestate_digest
        ),
        read_configuration=destination.read_configuration,
        write_configuration=destination.write_configuration,
        postcheck=lambda _plan, target, _harness: (
            digest(destination.read_configuration()) == target
        ),
    )
    print(json.dumps(outcome.to_dict(), sort_keys=True))
    return 0 if outcome.status == "activated" else 2


def _controller_hook_present(value: Any) -> bool:
    if isinstance(value, Mapping):
        command = value.get("command")
        if isinstance(command, str):
            try:
                arguments = shlex.split(command, posix=True)
            except ValueError:
                return "hindsight-memory" in command
            if any(Path(argument).name == "hindsight-memory" for argument in arguments):
                return True
        return any(_controller_hook_present(item) for item in value.values())
    if isinstance(value, list):
        return any(_controller_hook_present(item) for item in value)
    return False


def harness_config_status_command(args: argparse.Namespace) -> int:
    destination = _harness_destination(args)
    current = destination.read_configuration()
    hooks = current.get("hooks", {})
    settings = current.get("settings", {})
    if not isinstance(hooks, Mapping) or not isinstance(settings, Mapping):
        raise HarnessPersistenceError("native harness configuration is invalid")
    result = {
        "schema_version": 1,
        "harness_id": destination.harness_id,
        "configuration_digest": digest(current),
        "controller_hooks_present": _controller_hook_present(hooks),
        "auto_recall": settings.get("autoRecall"),
        "auto_retain": settings.get("autoRetain"),
    }
    if args.plan:
        record, receipt = _load_harness_activation_record(args.plan)
        result["approval_digest"] = record["approval_digest"]
        result["destination_matches"] = (
            record["destination"] == destination.to_record()
            and record["destination_digest"] == destination.destination_digest
        )
        result["plan_digest"] = receipt["plan_digest"]
        result["target_matches"] = digest(current) == receipt["target_digest"]
    print(json.dumps(result, sort_keys=True))
    return 0


def _disable_harness_authority(
    destination: NativeHarnessDestination,
    upstream_integration_roots: tuple[str, ...],
) -> Mapping[str, Any]:
    try:
        current = destination.read_configuration()
        target = native_fail_closed_configuration(
            destination.harness_id,
            current,
            upstream_integration_roots=upstream_integration_roots,
        )
        disabled = destination.write_configuration(
            digest(current),
            target,
        )
        matches = digest(disabled) == digest(target)
    except (TypeError, ValueError) as error:
        raise HarnessPersistenceError(
            "unsafe harness authority could not be disabled"
        ) from error
    if not matches:
        raise HarnessPersistenceError(
            "unsafe harness authority could not be disabled"
        )
    return disabled


def harness_config_disable_command(args: argparse.Namespace) -> int:
    destination = _harness_destination(args)
    try:
        disabled = _disable_harness_authority(
            destination,
            tuple(args.upstream_integration_root or ()),
        )
    except (TypeError, ValueError) as error:
        raise HarnessPersistenceError(
            "unsafe harness authority could not be disabled"
        ) from error
    result = {
        "schema_version": 1,
        "harness_id": destination.harness_id,
        "status": "disabled",
        "configuration_digest": digest(disabled),
    }
    print(json.dumps(result, sort_keys=True))
    return 0


def _read_harness_reconciliation_config(
    config_path: str | Path,
) -> tuple[Mapping[str, Any], str]:
    try:
        evidence = read_file_evidence(
            config_path,
            "harness reconciliation configuration",
            max_bytes=1024 * 1024,
        )
        if evidence is None:
            raise HarnessPersistenceError(
                "harness reconciliation configuration is unavailable"
            )
        payload, payload_digest = evidence
        config = strict_json_loads(payload)
    except (FileEvidenceError, OSError, StrictJsonError) as error:
        raise HarnessPersistenceError(
            "harness reconciliation configuration is invalid"
        ) from error
    if not isinstance(config, Mapping):
        raise HarnessPersistenceError(
            "harness reconciliation configuration is invalid"
        )
    return config, payload_digest


def _harness_reconciliation_controller_state(
    config_value: str | Path | Mapping[str, Any],
) -> Mapping[str, str]:
    if isinstance(config_value, Mapping):
        config = config_value
    else:
        config, _config_digest = _read_harness_reconciliation_config(
            config_value
        )
    if (
        not isinstance(config, Mapping)
        or set(config)
        != {
            "schema_version",
            "state_dir",
            "inventory",
            "policy",
            "profile",
            "token_env",
            "entries",
            "schedule_paths",
        }
        or config["schema_version"] != 1
        or not isinstance(config["entries"], list)
        or len(config["entries"]) != len(SUPPORTED_NATIVE_HARNESSES)
        or not isinstance(config["schedule_paths"], list)
    ):
        raise HarnessPersistenceError(
            "harness reconciliation configuration is invalid"
        )
    inventory_path = Path(config["inventory"])
    policy_path = Path(config["policy"])
    if (
        not inventory_path.is_absolute()
        or not policy_path.is_absolute()
    ):
        raise HarnessPersistenceError(
            "harness reconciliation configuration is invalid"
        )
    hook_state = []
    harness_ids = set()
    for entry in config["entries"]:
        if (
            not isinstance(entry, Mapping)
            or set(entry)
            != {
                "destination",
                "generation",
                "plan",
                "upstream_integration_roots",
            }
            or any(
                not isinstance(entry.get(key), str)
                for key in ("destination", "generation", "plan")
            )
            or not isinstance(entry["upstream_integration_roots"], list)
            or not entry["upstream_integration_roots"]
            or any(
                not isinstance(root, str)
                for root in entry["upstream_integration_roots"]
            )
        ):
            raise HarnessPersistenceError(
                "harness reconciliation entry is invalid"
            )
        destination_record = read_json(entry["destination"])
        harness_id = (
            destination_record.get("harness_id")
            if isinstance(destination_record, Mapping)
            else None
        )
        if (
            not isinstance(harness_id, str)
            or harness_id not in SUPPORTED_NATIVE_HARNESSES
            or harness_id in harness_ids
            or any(
                not isinstance(destination_record.get(key), str)
                for key in (
                    "hooks_path",
                    "settings_path",
                    "tools_path",
                )
            )
        ):
            raise HarnessPersistenceError(
                "harness reconciliation entries are incomplete"
            )
        harness_ids.add(harness_id)
        try:
            staged_generation = verify_native_harness_generation(
                entry["generation"]
            )
        except ValueError as error:
            raise HarnessPersistenceError(
                "harness reconciliation generation is invalid"
            ) from error
        if harness_id not in staged_generation:
            raise HarnessPersistenceError(
                "harness reconciliation generation is incomplete"
            )
        surfaces = []
        for surface in ("hooks_path", "settings_path", "tools_path"):
            surface_path = Path(destination_record[surface])
            if not surface_path.is_absolute():
                raise HarnessPersistenceError(
                    "harness reconciliation destination is invalid"
                )
            surfaces.append(
                {
                    "surface": surface,
                    "path": str(surface_path),
                    "content_digest": _regular_file_digest(
                        surface_path,
                        "harness reconciliation surface",
                    ),
                }
            )
        hook_state.append(
            {
                "harness_id": harness_id,
                "destination": entry["destination"],
                "destination_digest": _regular_file_digest(
                    Path(entry["destination"]),
                    "harness reconciliation destination",
                ),
                "generation": entry["generation"],
                "generation_digest": Path(entry["generation"]).name,
                "plan_digest": _regular_file_digest(
                    Path(entry["plan"]),
                    "harness reconciliation plan",
                ),
                "upstream_integration_roots": sorted(
                    entry["upstream_integration_roots"]
                ),
                "surfaces": surfaces,
            }
        )
    if harness_ids != SUPPORTED_NATIVE_HARNESSES:
        raise HarnessPersistenceError(
            "harness reconciliation entries are incomplete"
        )
    hook_state.sort(key=lambda item: item["harness_id"])
    schedule_state = []
    for path_value in config["schedule_paths"]:
        if not isinstance(path_value, str):
            raise HarnessPersistenceError(
                "harness reconciliation schedule path is invalid"
            )
        path = Path(path_value)
        if not path.is_absolute():
            raise HarnessPersistenceError(
                "harness reconciliation schedule path is invalid"
            )
        schedule_state.append(
            {
                "path": str(path),
                "content_digest": _regular_file_digest(
                    path,
                    "harness reconciliation schedule",
                ),
            }
        )
    schedule_state.sort(key=lambda item: item["path"])
    return {
        "configuration_digest": digest(
            {
                "reconciliation": config,
                "inventory_digest": _regular_file_digest(
                    inventory_path,
                    "harness reconciliation inventory",
                ),
                "policy_digest": _regular_file_digest(
                    policy_path,
                    "harness reconciliation policy",
                ),
            }
        ),
        "hook_digest": digest(hook_state),
        "schedule_digest": digest(schedule_state),
    }


def harness_config_reconcile_command(args: argparse.Namespace) -> int:
    config, observed_config_digest = _read_harness_reconciliation_config(
        args.config
    )
    expected_config_digest = args.config_digest
    if (
        not isinstance(expected_config_digest, str)
        or re.fullmatch(r"[0-9a-f]{64}", expected_config_digest) is None
        or not hmac.compare_digest(
            observed_config_digest,
            expected_config_digest,
        )
    ):
        raise HarnessPersistenceError(
            "harness reconciliation configuration digest does not match"
        )
    if (
        not isinstance(config, Mapping)
        or set(config)
        != {
            "schema_version",
            "state_dir",
            "inventory",
            "policy",
            "profile",
            "token_env",
            "entries",
            "schedule_paths",
        }
        or config["schema_version"] != 1
        or not isinstance(config["entries"], list)
        or len(config["entries"]) != len(SUPPORTED_NATIVE_HARNESSES)
        or not isinstance(config["schedule_paths"], list)
    ):
        raise HarnessPersistenceError(
            "harness reconciliation configuration is invalid"
        )
    if (
        not isinstance(config["state_dir"], str)
        or not isinstance(config["inventory"], str)
        or not isinstance(config["policy"], str)
        or not isinstance(config["profile"], str)
        or not isinstance(config["token_env"], str)
    ):
        raise HarnessPersistenceError(
            "harness reconciliation configuration is invalid"
        )
    state_dir = Path(config["state_dir"])
    inventory_path = Path(config["inventory"])
    policy_path = Path(config["policy"])
    if (
        not state_dir.is_absolute()
        or not inventory_path.is_absolute()
        or not policy_path.is_absolute()
        or ENVIRONMENT_NAME.fullmatch(config["token_env"]) is None
    ):
        raise HarnessPersistenceError(
            "harness reconciliation configuration is invalid"
        )
    activation_records: list[
        tuple[Mapping[str, Any], Mapping[str, Any]]
    ] = []
    for entry in config["entries"]:
        if (
            not isinstance(entry, Mapping)
            or set(entry)
            != {
                "destination",
                "generation",
                "plan",
                "upstream_integration_roots",
            }
            or not isinstance(entry["upstream_integration_roots"], list)
            or not entry["upstream_integration_roots"]
            or any(
                not isinstance(entry[key], str)
                for key in ("destination", "generation", "plan")
            )
            or any(
                not isinstance(root, str)
                for root in entry["upstream_integration_roots"]
            )
        ):
            raise HarnessPersistenceError(
                "harness reconciliation entry is invalid"
            )
        activation_records.append(
            _load_harness_activation_record(entry["plan"])
        )
    configured_harnesses = {
        receipt.get("harness_id")
        for _record, receipt in activation_records
    }
    if configured_harnesses != SUPPORTED_NATIVE_HARNESSES:
        raise HarnessPersistenceError(
            "harness reconciliation entries are incomplete"
        )
    destinations = [entry["destination"] for entry in config["entries"]]
    generations = [entry["generation"] for entry in config["entries"]]
    if (
        len(set(destinations)) != len(destinations)
        or len(set(generations)) != len(generations)
    ):
        raise HarnessPersistenceError(
            "harness reconciliation entries are not unique"
        )
    prepared_entries = []
    for entry, (record, receipt) in zip(
        config["entries"],
        activation_records,
        strict=True,
    ):
        verify_args = argparse.Namespace(
            state_dir=str(state_dir),
            destination=entry["destination"],
            generation=entry["generation"],
            inventory=str(inventory_path),
            policy=str(policy_path),
            upstream_integration_root=entry["upstream_integration_roots"],
            plan=entry["plan"],
            approval_digest=record["approval_digest"],
        )
        destination = _harness_destination(verify_args)
        if destination.harness_id != receipt["harness_id"]:
            raise HarnessPersistenceError(
                "harness reconciliation destination harness changed"
            )
        _validate_activation_record(
            destination,
            record,
            receipt,
            record["approval_digest"],
        )
        prepared_entries.append(
            (verify_args, destination, receipt)
        )

    failures = []
    first_unexpected_error: Exception | None = None
    for verify_args, destination, receipt in prepared_entries:
        harness_id = receipt["harness_id"]
        failure: dict[str, Any] | None = None
        try:
            if (
                args.phase == "post-start"
                and hmac.compare_digest(
                    digest(destination.read_configuration()),
                    receipt["expected_prestate_digest"],
                )
            ):
                apply_args = argparse.Namespace(
                    **vars(verify_args),
                    broker_healthy=True,
                    profile_healthy=True,
                    adapter_self_test=True,
                )
                if harness_config_apply_command(apply_args) != 0:
                    failure = {
                        "harness_id": harness_id,
                        "reason": "activation_restore_failed",
                    }
            verify_result = harness_config_verify_command(verify_args)
            if verify_result != 0 and failure is None:
                failure = {
                    "harness_id": harness_id,
                    "reason": "activation_drift",
                }
        except HarnessPersistenceError:
            failure = {
                "harness_id": harness_id,
                "reason": "verification_error",
            }
        except Exception as error:
            if first_unexpected_error is None:
                first_unexpected_error = error
        if failure is not None:
            failures.append(failure)

    def disable_all() -> tuple[list[dict[str, Any]], Exception | None]:
        disable_failures: list[dict[str, Any]] = []
        disable_error: Exception | None = None
        for verify_args, destination, receipt in prepared_entries:
            harness_id = receipt["harness_id"]
            try:
                _disable_harness_authority(
                    destination,
                    tuple(verify_args.upstream_integration_root),
                )
            except HarnessPersistenceError:
                disable_failures.append(
                    {
                        "harness_id": harness_id,
                        "reason": "disable_failed",
                    }
                )
            except Exception as error:
                disable_failures.append(
                    {
                        "harness_id": harness_id,
                        "reason": "disable_failed",
                    }
                )
                if disable_error is None:
                    disable_error = error
        disable_failures.sort(key=lambda item: item["harness_id"])
        return disable_failures, disable_error

    disable_failures: list[dict[str, Any]] = []
    if failures or first_unexpected_error is not None:
        disable_failures, disable_error = disable_all()
        if first_unexpected_error is None:
            first_unexpected_error = disable_error
    failures.sort(key=lambda item: (item["harness_id"], item["reason"]))
    if first_unexpected_error is not None:
        if failures or disable_failures:
            first_unexpected_error.add_note(
                "harness reconciliation fail-closed summary: "
                + json.dumps(
                    {
                        "failures": failures,
                        "disable_failures": disable_failures,
                    },
                    sort_keys=True,
                )
            )
        raise first_unexpected_error
    if failures or disable_failures:
        print(
            json.dumps(
                {
                    "schema_version": 1,
                    "status": "degraded",
                    "failures": failures,
                    "disable_failures": disable_failures,
                },
                sort_keys=True,
            )
        )
        return 2

    try:
        controller_state = _harness_reconciliation_controller_state(config)
    except Exception as state_error:
        disable_failures, disable_error = disable_all()
        if disable_failures:
            state_error.add_note(
                "harness reconciliation fail-closed summary: "
                + json.dumps(
                    {"disable_failures": disable_failures},
                    sort_keys=True,
                )
            )
        if disable_error is not None:
            state_error.add_note(
                "harness reconciliation fail-closed raised an unexpected error: "
                + repr(disable_error)
            )
        raise
    hook_digest = controller_state["hook_digest"]
    if args.phase == "pre-start":
        print(
            json.dumps(
                {
                    "schema_version": 1,
                    "phase": "pre-start",
                    "status": "healthy",
                    "hook_digest": hook_digest,
                },
                sort_keys=True,
            )
        )
        return 0

    adapter_args = argparse.Namespace(
        inventory=str(inventory_path),
        profile=config["profile"],
        token_env=config["token_env"],
    )
    try:
        generation_adapter = _replay_http_adapter(adapter_args)
        generation_adapter.read_migration_generation()
        server_state = generation_adapter.record_controller_state(
            controller_state
        )
        generation = (
            server_state.get("generation")
            if isinstance(server_state, Mapping)
            else None
        )
        if not isinstance(generation, str) or not generation:
            raise HarnessPersistenceError(
                "harness reconciliation controller state is invalid"
            )
    except Exception as server_error:
        disable_failures, disable_error = disable_all()
        if disable_failures:
            server_error.add_note(
                "harness reconciliation fail-closed summary: "
                + json.dumps(
                    {"disable_failures": disable_failures},
                    sort_keys=True,
                )
            )
        if disable_error is not None:
            server_error.add_note(
                "harness reconciliation fail-closed raised an unexpected error: "
                + repr(disable_error)
            )
        raise
    print(
        json.dumps(
            {
                "schema_version": 1,
                "phase": "post-start",
                "status": "healthy",
                "hook_digest": hook_digest,
                "server_generation": generation,
            },
            sort_keys=True,
        )
    )
    return 0


def harness_config_verify_command(args: argparse.Namespace) -> int:
    destination = _harness_destination(args)
    record, receipt = _load_harness_activation_record(args.plan)
    _validate_activation_record(
        destination, record, receipt, args.approval_digest
    )
    prestate = destination.read_rollback(receipt["expected_prestate_digest"])
    plan = _reconstruct_harness_activation_plan(args, receipt, prestate)
    current = destination.read_configuration()
    try:
        findings = native_activation_findings(
            plan,
            current,
        )
    except (TypeError, ValueError) as error:
        raise HarnessPersistenceError(
            "harness activation verification failed"
        ) from error
    if not findings:
        print(
            json.dumps(
                {
                    "schema_version": 1,
                    "harness_id": destination.harness_id,
                    "status": "healthy",
                    "reason": "ok",
                    "configuration_digest": digest(current),
                    "plan_digest": plan.plan_digest,
                    "findings": [],
                },
                sort_keys=True,
            )
        )
        return 0
    try:
        target = native_fail_closed_target(
            plan,
            current,
        )
        disabled = destination.write_configuration(
            digest(current),
            deep_thaw(target),
        )
    except (TypeError, ValueError) as error:
        raise HarnessPersistenceError(
            "unsafe harness activation could not be disabled"
        ) from error
    disabled_matches = digest(disabled) == digest(target)
    print(
        json.dumps(
            {
                "schema_version": 1,
                "harness_id": destination.harness_id,
                "status": "disabled" if disabled_matches else "disable_failed",
                "reason": "activation_drift",
                "configuration_digest": digest(disabled),
                "plan_digest": plan.plan_digest,
                "findings": list(findings),
            },
            sort_keys=True,
        )
    )
    return 2


def harness_config_rollback_command(args: argparse.Namespace) -> int:
    destination = _harness_destination(args)
    record, receipt = _load_harness_activation_record(args.plan)
    _validate_activation_record(
        destination, record, receipt, args.approval_digest
    )
    prestate = destination.read_rollback(receipt["expected_prestate_digest"])
    plan = _reconstruct_harness_activation_plan(args, receipt, prestate)
    current = destination.read_configuration()
    try:
        target = native_fail_closed_target(
            plan,
            current,
        )
    except (TypeError, ValueError) as error:
        raise HarnessPersistenceError("harness rollback target is invalid") from error
    restored = destination.write_configuration(
        digest(current),
        deep_thaw(target),
    )
    succeeded = digest(restored) == digest(target)
    print(
        json.dumps(
            {
                "schema_version": 1,
                "harness_id": destination.harness_id,
                "approval_digest": record["approval_digest"],
                "plan_digest": plan.plan_digest,
                "status": "rolled_back" if succeeded else "rollback_failed",
                "configuration_digest": digest(restored),
                "prestate_path": str(
                    destination.rollback_path(plan.expected_prestate_digest)
                ),
            },
            sort_keys=True,
        )
    )
    return 0 if succeeded else 2


def _add_socket(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--socket", required=True)
    parser.add_argument("--timeout", type=_argparse_timeout, default=2.0)


def _argparse_timeout(value: str) -> float:
    try:
        timeout = float(value)
    except (TypeError, ValueError):
        raise argparse.ArgumentTypeError("BROKER_TIMEOUT_INVALID") from None
    if not math.isfinite(timeout) or not 0 <= timeout <= 30:
        raise argparse.ArgumentTypeError("BROKER_TIMEOUT_INVALID")
    return timeout


def _argparse_session_ttl(value: str) -> float:
    try:
        ttl = float(value)
    except (TypeError, ValueError):
        raise argparse.ArgumentTypeError("SESSION_TTL_INVALID") from None
    if not math.isfinite(ttl) or not 0 < ttl <= MAX_SESSION_TTL_SECONDS:
        raise argparse.ArgumentTypeError("SESSION_TTL_INVALID")
    return ttl


def _add_session_request(
    parser: argparse.ArgumentParser,
    *,
    rpc_method: str,
    request: bool = True,
) -> None:
    _add_socket(parser)
    parser.add_argument(
        "--capability-env", default="HINDSIGHT_MEMORY_SESSION_CAPABILITY"
    )
    parser.add_argument("--sequence", type=int, required=True)
    parser.add_argument("--action-id", required=True)
    if request:
        parser.add_argument("--request", required=True)
    parser.set_defaults(run=broker_method_command, rpc_method=rpc_method)


def _portable_manager(args: argparse.Namespace) -> PortableInstallationManager:
    return PortableInstallationManager(InstallationConfig.read(args.config))


def _require_candidate_install_runtime(release_root: str) -> None:
    try:
        candidate_root = Path(release_root).resolve(strict=True)
        runtime_root = Path(__file__).resolve(strict=True).parents[1]
    except OSError as error:
        raise PortableInstallError(
            "candidate release runtime is unavailable"
        ) from error
    if candidate_root != runtime_root:
        raise PortableInstallError(
            "install and upgrade must run from the candidate release's "
            "hindsight-memory CLI"
        )


def portable_install_command(args: argparse.Namespace) -> int:
    _require_candidate_install_runtime(args.release_root)
    return _print_result(
        _portable_manager(args).install(args.release_root, version=args.version)
    )


def portable_upgrade_command(args: argparse.Namespace) -> int:
    _require_candidate_install_runtime(args.release_root)
    handoff = (
        None
        if args.verified_rebind_plan is None
        else read_json(args.verified_rebind_plan)
    )
    optional: dict[str, Any] = {}
    if handoff is not None:
        optional["verified_rebind_plan"] = handoff
    return _print_result(
        _portable_manager(args).upgrade(
            args.release_root,
            version=args.version,
            expected_current_binding_generation_digest=(
                args.expected_current_binding_generation_digest
            ),
            **optional,
        )
    )


def portable_verify_command(args: argparse.Namespace) -> int:
    return _print_result(_portable_manager(args).verify())


def portable_rollback_command(args: argparse.Namespace) -> int:
    return _print_result(
        _portable_manager(args).rollback(
            expected_current_digest=args.expected_current_release_digest
        )
    )


def portable_uninstall_command(args: argparse.Namespace) -> int:
    return _print_result(_portable_manager(args).uninstall())


def data_identity_rebind_plan_command(args: argparse.Namespace) -> int:
    plan = _portable_manager(args).data_identity_rebind_plan(
        read_json(args.evidence)
    )
    write_private(args.output, plan, create_only=True)
    return _print_result(
        {
            "status": "planned",
            "plan_digest": plan["plan_digest"],
            "expires_at": plan["expires_at"],
            "output": str(Path(args.output).resolve()),
        }
    )


def data_identity_rebind_apply_command(args: argparse.Namespace) -> int:
    return _print_result(
        _portable_manager(args).data_identity_rebind_apply(
            read_json(args.plan),
            approval_digest=args.approval_digest,
            pre_apply_evidence_value=read_json(args.pre_apply_evidence),
        )
    )


def data_identity_rebind_status_command(args: argparse.Namespace) -> int:
    return _print_result(
        _portable_manager(args).data_identity_rebind_status(read_json(args.plan))
    )


def data_identity_rebind_verify_command(args: argparse.Namespace) -> int:
    result = _portable_manager(args).data_identity_rebind_verify(
        read_json(args.plan),
        read_json(args.post_evidence),
    )
    write_private(args.output, result, create_only=True)
    return _print_result(result)


def data_identity_rebind_rollback_command(args: argparse.Namespace) -> int:
    return _print_result(
        _portable_manager(args).data_identity_rebind_rollback(
            read_json(args.plan),
            approval_digest=args.approval_digest,
        )
    )


DATA_IDENTITY_QUIESCENT_LAUNCHD_LABELS = (
    "io.nisavid.hindsight.stlz-ivan-mbp.stack",
    "io.nisavid.hindsight.stlz-ivan-mbp.hook-authority",
    "com.hindsight.embed.stack",
)


def _data_identity_safety_evidence(
    database: Mapping[str, Any],
) -> dict[str, Any]:
    if sys.platform != "darwin":
        raise DataIdentityRebindError(
            "data-identity safety observation is unsupported"
        )
    domain = f"gui/{os.getuid()}"
    for label in DATA_IDENTITY_QUIESCENT_LAUNCHD_LABELS:
        try:
            result = subprocess.run(
                (
                    "/bin/launchctl",
                    "print",
                    f"{domain}/{label}",
                ),
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=10,
                check=False,
            )
        except (OSError, subprocess.SubprocessError) as error:
            raise DataIdentityRebindError(
                "data-identity launchd safety state is unavailable"
            ) from error
        if result.returncode == 0:
            raise DataIdentityRebindError(
                "data-identity launchd safety state is active"
            )
        if result.returncode != 113:
            raise DataIdentityRebindError(
                "data-identity launchd safety state is unavailable"
            )
    if database.get("generic_import_receipt_count") != 0:
        raise DataIdentityRebindError(
            "generic import authority is already present"
        )
    return {
        "hooks_disabled": True,
        "controller_authority_disabled": True,
        "no_serena_import_authority": True,
        "target_bank_inspected": False,
        "database_mutation_performed": False,
    }


async def _read_live_data_identity_evidence(
    *,
    profile_id: str,
    expected_system_identifier: str,
) -> tuple[dict[str, Any], dict[str, Any], dict[str, Any]]:
    binding = read_pg0_registration(profile_id)
    password = binding.pop("_password")
    asyncpg = _load_asyncpg()
    connection = await connect_verified_local_postgres(
        asyncpg,
        binding,
        password=password,
        readonly=True,
    )
    try:
        await assert_connected_live_database(
            connection,
            binding,
            expected_system_identifier=expected_system_identifier,
        )
        system_identifier = await connection.fetchval(
            "SELECT system_identifier::text FROM pg_control_system()"
        )
        postgres = build_postgres_evidence(
            binding,
            system_identifier=system_identifier,
        )
        database = await read_database_evidence(
            connection,
            postgres=postgres,
            profile_id=profile_id,
        )
        return binding, postgres, database
    finally:
        password = ""
        await connection.close()


def data_identity_rebind_evidence_command(args: argparse.Namespace) -> int:
    paths = (args.artifact, args.backup_attestation, args.output)
    if (
        any(not Path(value).is_absolute() for value in paths)
        or len(
            {
                unicodedata.normalize(
                    "NFD",
                    str(Path(value).resolve(strict=False)).casefold(),
                )
                for value in paths
            }
        )
        != len(paths)
    ):
        raise PortableInstallError(
            "data-identity evidence path aliases an artifact"
        )
    args.data_identity_output = args.output
    args.output = args.backup_attestation
    args.data_identity_collected_at = int(time.time())
    return operation_recovery_backup_live_command(args)


def data_identity_rebind_observe_command(args: argparse.Namespace) -> int:
    manager = _portable_manager(args)
    manager._preflight_lifecycle()
    manager._validate_config_source()
    verification_time = int(time.time())
    base = read_json(args.base_evidence)
    try:
        checked = verify_rebind_evidence(base, now=verification_time)
        _binding, postgres, database = asyncio.run(
            _read_live_data_identity_evidence(
                profile_id=checked["profile_id"],
                expected_system_identifier=checked["postgres"][
                    "system_identifier"
                ],
            )
        )
        if Path(postgres["data_root"]).resolve(strict=True) != (
            manager.config.data_root.resolve(strict=True)
        ):
            raise DataIdentityRebindError(
                "data-identity evidence data root differs"
            )
        safety = _data_identity_safety_evidence(database)
        if safety != checked["safety"]:
            raise DataIdentityRebindError(
                "data-identity safety evidence differs"
            )
        observation_time = int(time.time())
        evidence = refresh_rebind_evidence(
            checked,
            postgres=postgres,
            database=database,
            now=observation_time,
        )
    except DataIdentityRebindError as error:
        raise PortableInstallError(str(error)) from error
    write_private(args.output, evidence, create_only=True)
    return _print_result(
        {
            "status": "observed",
            "evidence_digest": digest(evidence),
            "expires_at": evidence["expires_at"],
            "output": str(Path(args.output).resolve()),
        }
    )


