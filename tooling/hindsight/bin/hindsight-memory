class BrokerProcessIdentity(NamedTuple):
    pid: int
    start_time: str | None
    shutdown_capability: str | None = None
    profile_set_digest: str | None = None


def read_json(path: str | Path) -> Any:
    return strict_json_loads(Path(path).read_text(encoding="utf-8"))


def _integration_runner(path: str, operation: str):
    runner = Path(path)
    runner_digest = _regular_file_digest(runner, f"{operation} runner")

    def invoke(payload: Mapping[str, Any]) -> Mapping[str, Any]:
        request = {"schema_version": 1, "operation": operation, **payload}
        process: subprocess.Popen[bytes] | None = None
        output = bytearray()
        transport_error: list[str] = []
        writer_error: list[str] = []
        try:
            process = subprocess.Popen(
                [str(runner)],
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                # Runner-controlled diagnostics may contain package content or
                # credentials. Failures stay generic and stderr is never retained.
                stderr=subprocess.DEVNULL,
                cwd="/",
                env={"PATH": "/usr/bin:/bin", "LANG": "C", "LC_ALL": "C"},
                close_fds=True,
            )
            if process.stdin is None or process.stdout is None:
                raise OSError("runner pipes unavailable")
            descriptor = process.stdout.fileno()

            def read_output() -> None:
                while True:
                    try:
                        chunk = os.read(descriptor, 64 * 1024)
                    except OSError:
                        return
                    if not chunk:
                        return
                    output.extend(chunk)
                    if len(output) > 1024 * 1024:
                        transport_error.append("output-limit")
                        if process is not None and process.poll() is None:
                            process.kill()
                        return

            def write_input() -> None:
                try:
                    assert process is not None and process.stdin is not None
                    process.stdin.write(canonical_bytes(request))
                except OSError:
                    writer_error.append("write-failed")
                finally:
                    if process is not None and process.stdin is not None:
                        try:
                            process.stdin.close()
                        except OSError:
                            if not writer_error:
                                writer_error.append("close-failed")

            reader = threading.Thread(target=read_output, daemon=True)
            writer = threading.Thread(target=write_input, daemon=True)
            reader.start()
            writer.start()
            deadline = time.monotonic() + 300
            while reader.is_alive() or writer.is_alive():
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    break
                slice_timeout = min(remaining, 0.25)
                if reader.is_alive():
                    reader.join(timeout=slice_timeout)
                else:
                    writer.join(timeout=slice_timeout)
            if reader.is_alive() or writer.is_alive():
                process.kill()
                reader.join(timeout=5)
                writer.join(timeout=5)
                raise subprocess.TimeoutExpired(str(runner), 300)
            process.wait(timeout=5)
            if transport_error:
                raise IntegrationUpgradeError(
                    f"{operation} runner output exceeds limit"
                )
        except IntegrationUpgradeError:
            raise
        except subprocess.TimeoutExpired as error:
            if process is not None and process.poll() is None:
                process.kill()
                process.wait(timeout=5)
            raise IntegrationUpgradeError(f"{operation} runner timed out") from error
        except (OSError, subprocess.SubprocessError) as error:
            if process is not None and process.poll() is None:
                process.kill()
                process.wait(timeout=5)
            raise IntegrationUpgradeError(f"{operation} runner failed") from error
        finally:
            if process is not None and process.stdout is not None:
                process.stdout.close()
        if process is None or process.returncode != 0:
            raise IntegrationUpgradeError(f"{operation} runner failed")
        if writer_error:
            raise IntegrationUpgradeError(f"{operation} runner failed")
        try:
            result = strict_json_loads(bytes(output))
        except (StrictJsonError, UnicodeDecodeError) as error:
            raise IntegrationUpgradeError(
                f"{operation} runner output is invalid"
            ) from error
        if not isinstance(result, Mapping):
            raise IntegrationUpgradeError(f"{operation} runner output is invalid")
        return result

    return invoke, runner_digest


def _integration_manager(args: argparse.Namespace) -> IntegrationUpgradeManager:
    catalog = IntegrationCatalogEntry.load(read_json(args.catalog))
    policy = IntegrationUpdatePolicy.load(read_json(args.update_policy))
    source, source_digest = _integration_runner(args.source_verifier, "verify-source")
    compatibility, compatibility_digest = _integration_runner(
        args.compatibility_runner, "test-compatibility"
    )
    smoke, smoke_digest = _integration_runner(args.smoke_runner, "smoke")

    def source_verifier(manifest: PackageManifest) -> Mapping[str, Any]:
        return source({"catalog": catalog.to_dict(), "manifest": manifest.to_dict()})

    def compatibility_runner(
        candidate: Path, manifest: PackageManifest
    ) -> Mapping[str, Any]:
        return compatibility(
            {"candidate_path": str(candidate), "manifest": manifest.to_dict()}
        )

    def smoke_runner(candidate: Path, manifest: PackageManifest) -> bool:
        result = smoke(
            {"candidate_path": str(candidate), "manifest": manifest.to_dict()}
        )
        return result == {
            "schema_version": 1,
            "artifact_sha256": manifest.artifact_sha256,
            "passed": True,
        }

    return IntegrationUpgradeManager(
        args.state_dir,
        catalog=catalog,
        policy=policy,
        source_verifier=source_verifier,
        source_verifier_digest=source_digest,
        compatibility_runner=compatibility_runner,
        compatibility_runner_digest=compatibility_digest,
        smoke_runner=smoke_runner,
        smoke_runner_digest=smoke_digest,
    )


def integration_upgrade_plan_command(args: argparse.Namespace) -> int:
    manager = _integration_manager(args)
    manifest = PackageManifest.load(read_json(args.manifest))
    if args.package:
        package = Path(args.package).read_bytes()
        plan = manager.plan(manifest, package=package)
    else:
        plan = manager.download_and_plan(manifest)
    output = (
        Path(args.output)
        if args.output
        else Path(args.state_dir) / "approved-plan.json"
    )
    write_private(output, plan.to_dict())
    print(
        json.dumps(
            {
                "plan": str(output),
                "plan_digest": plan.plan_digest,
                "disposition": plan.disposition,
                "memory_authority": plan.memory_authority,
            },
            sort_keys=True,
        )
    )
    return 0


def integration_upgrade_check_command(args: argparse.Namespace) -> int:
    outcome = _integration_manager(args).check_for_update()
    print(json.dumps(outcome, sort_keys=True))
    return 0


def integration_upgrade_apply_command(args: argparse.Namespace) -> int:
    if args.recover_pending:
        if not args.harness:
            raise IntegrationUpgradeError("pending recovery requires --harness")
        if args.plan or args.approval_digest or args.automatic:
            raise IntegrationUpgradeError(
                "pending recovery cannot be combined with an upgrade plan"
            )
        print(
            json.dumps(
                recover_integration_upgrade(args.state_dir, args.harness),
                sort_keys=True,
            )
        )
        return 0
    if args.harness:
        raise IntegrationUpgradeError("--harness is valid only with --recover-pending")
    for name in (
        "catalog",
        "update_policy",
        "source_verifier",
        "compatibility_runner",
        "smoke_runner",
    ):
        if not getattr(args, name, None):
            raise IntegrationUpgradeError(
                "upgrade apply requires verifier and runner bindings"
            )
    manager = _integration_manager(args)
    if not args.plan or not args.approval_digest:
        raise IntegrationUpgradeError(
            "upgrade apply requires --plan and --approval-digest"
        )
    plan = IntegrationUpgradePlan.load(read_json(args.plan))
    outcome = manager.apply(
        plan,
        approval_digest=args.approval_digest,
        automatic=args.automatic,
    )
    print(json.dumps(outcome, sort_keys=True))
    return 0


def integration_upgrade_status_command(args: argparse.Namespace) -> int:
    print(
        json.dumps(
            read_integration_upgrade_status(args.state_dir, args.harness),
            sort_keys=True,
        )
    )
    return 0


def integration_upgrade_rollback_command(args: argparse.Namespace) -> int:
    manager = _integration_manager(args)
    outcome = manager.rollback(
        args.harness,
        expected_current_artifact_sha256=(args.expected_current_artifact_sha256),
    )
    print(json.dumps(outcome, sort_keys=True))
    return 0


def _regular_file_digest(value: str | Path, label: str) -> str:
    path = Path(value)
    if not path.is_absolute():
        raise ApplyError(f"{label} path must be absolute")
    try:
        reject_symlink_components(path, label, allow_missing=False)
        flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
        descriptor = os.open(path, flags)
        try:
            before = os.fstat(descriptor)
            validate_trusted_regular_file(before, label)
            artifact_hash = hashlib.sha256()
            while chunk := os.read(descriptor, 1024 * 1024):
                artifact_hash.update(chunk)
            after = os.fstat(descriptor)
        finally:
            os.close(descriptor)
        current = path.lstat()
    except FileEvidenceError as error:
        raise ApplyError(str(error)) from None
    except OSError:
        raise ApplyError(f"{label} is unavailable") from None
    if file_identity(before) != file_identity(after) or (
        current.st_dev,
        current.st_ino,
    ) != (after.st_dev, after.st_ino):
        raise ApplyError(f"{label} changed while being read")
    return artifact_hash.hexdigest()


def _paths_overlap(candidate: str | Path, protected: list[str | Path]) -> bool:
    candidate_path = Path(candidate)
    if not candidate_path.is_absolute():
        raise ApplyError("rollback archive path must be absolute")
    candidate_resolved = candidate_path.resolve(strict=False)
    for value in protected:
        protected_path = Path(value)
        if candidate_resolved == protected_path.resolve(strict=False):
            return True
        try:
            if (
                candidate_path.exists()
                and protected_path.exists()
                and os.path.samefile(candidate_path, protected_path)
            ):
                return True
        except OSError:
            raise ApplyError("migration archive identity is unavailable") from None
    return False


def _open_private_parent(path: Path) -> int:
    if not hasattr(os, "O_DIRECTORY") or not hasattr(os, "O_NOFOLLOW"):
        raise OSError("symlink-safe directory access is unavailable")
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    absolute = Path(os.path.abspath(path))
    if sys.platform == "darwin" and len(absolute.parts) > 1:
        aliases = {
            "var": ("private", "var"),
            "tmp": ("private", "tmp"),
            "etc": ("private", "etc"),
        }
        replacement = aliases.get(absolute.parts[1])
        if replacement is not None:
            absolute = Path("/").joinpath(*replacement, *absolute.parts[2:])
    descriptor = os.open("/", flags)
    try:
        root_metadata = os.fstat(descriptor)
        if (
            not stat.S_ISDIR(root_metadata.st_mode)
            or root_metadata.st_uid != 0
            or stat.S_IMODE(root_metadata.st_mode) & 0o022
        ):
            raise OSError("private artifact root ancestry is untrusted")
        for component in absolute.parts[1:]:
            try:
                child = os.open(component, flags, dir_fd=descriptor)
            except FileNotFoundError:
                try:
                    os.mkdir(component, 0o700, dir_fd=descriptor)
                except FileExistsError:
                    pass
                else:
                    os.fsync(descriptor)
                child = os.open(component, flags, dir_fd=descriptor)
            metadata = os.fstat(child)
            if (
                not stat.S_ISDIR(metadata.st_mode)
                or metadata.st_uid not in {0, os.geteuid()}
                or (
                    stat.S_IMODE(metadata.st_mode) & 0o022
                    and not (metadata.st_uid == 0 and metadata.st_mode & stat.S_ISVTX)
                )
            ):
                os.close(child)
                raise OSError("private artifact parent ancestry is untrusted")
            os.close(descriptor)
            descriptor = child
        final_metadata = os.fstat(descriptor)
        if (
            final_metadata.st_uid != os.geteuid()
            or stat.S_IMODE(final_metadata.st_mode) & 0o077
        ):
            raise OSError(
                "private artifact parent must be current-user-owned and private"
            )
        return descriptor
    except Exception:
        os.close(descriptor)
        raise


def _directory_entry_identity(directory: int, name: str) -> tuple[int, int] | None:
    try:
        metadata = os.stat(name, dir_fd=directory, follow_symlinks=False)
    except FileNotFoundError:
        return None
    if not stat.S_ISREG(metadata.st_mode):
        raise OSError("private artifact destination must be a regular file")
    return metadata.st_dev, metadata.st_ino


def _atomic_rename(directory: int, source: str, target: str, flag: int) -> None:
    library = ctypes.CDLL(None, use_errno=True)
    function_name = "renameatx_np" if sys.platform == "darwin" else "renameat2"
    try:
        rename = getattr(library, function_name)
    except AttributeError as error:
        raise OSError("atomic conditional rename is unavailable") from error
    rename.argtypes = [
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_uint,
    ]
    rename.restype = ctypes.c_int
    if (
        rename(
            directory,
            os.fsencode(source),
            directory,
            os.fsencode(target),
            flag,
        )
        != 0
    ):
        error_number = ctypes.get_errno()
        raise OSError(error_number, os.strerror(error_number), target)


def _commit_private_artifact(
    directory: int,
    temporary_name: str,
    target_name: str,
    expected_identity: tuple[int, int] | None,
) -> None:
    exclusive = 0x00000004 if sys.platform == "darwin" else 0x00000001
    exchange = 0x00000002
    if expected_identity is None:
        _atomic_rename(directory, temporary_name, target_name, exclusive)
        return

    new_identity = _directory_entry_identity(directory, temporary_name)
    if new_identity is None:
        raise OSError("private artifact temporary disappeared before commit")
    _atomic_rename(directory, temporary_name, target_name, exchange)
    try:
        displaced_identity = _directory_entry_identity(directory, temporary_name)
        if displaced_identity != expected_identity:
            raise OSError("private artifact destination changed during write")
    except Exception as error:
        try:
            _atomic_rename(directory, temporary_name, target_name, exchange)
            restored_identity = _directory_entry_identity(directory, target_name)
            restored_temporary = _directory_entry_identity(directory, temporary_name)
        except Exception as rollback_error:
            raise OSError(
                "private artifact exchange rollback is uncertain; preserving both entries"
            ) from rollback_error
        if restored_identity != expected_identity or restored_temporary != new_identity:
            raise OSError(
                "private artifact exchange rollback is uncertain; preserving both entries"
            ) from error
        raise
    os.unlink(temporary_name, dir_fd=directory)


def write_private(path: str | Path, value: Any, *, create_only: bool = False) -> None:
    target = Path(path)
    if target.name in {"", ".", ".."}:
        raise OSError("private artifact destination name is invalid")
    directory = _open_private_parent(target.parent)
    descriptor = -1
    temporary_name: str | None = None
    temporary_identity: tuple[int, int] | None = None
    try:
        expected_identity = _directory_entry_identity(directory, target.name)
        if create_only and expected_identity is not None:
            raise FileExistsError("private artifact destination already exists")
        temporary_flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
        for _attempt in range(16):
            candidate = f".{target.name}.{secrets.token_hex(16)}.tmp"
            try:
                descriptor = os.open(
                    candidate,
                    temporary_flags,
                    0o600,
                    dir_fd=directory,
                )
            except FileExistsError:
                continue
            temporary_name = candidate
            break
        if temporary_name is None:
            raise OSError("unable to allocate private temporary artifact")

        os.fchmod(descriptor, 0o600)
        temporary_metadata = os.fstat(descriptor)
        temporary_identity = temporary_metadata.st_dev, temporary_metadata.st_ino
        body = canonical_bytes(value) + b"\n"
        offset = 0
        while offset < len(body):
            written = os.write(descriptor, body[offset:])
            if written <= 0 or written > len(body) - offset:
                raise OSError("short private artifact write")
            offset += written
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        _commit_private_artifact(
            directory,
            temporary_name,
            target.name,
            expected_identity,
        )
        temporary_name = None
        os.fsync(directory)
    except Exception:
        if descriptor >= 0:
            try:
                os.close(descriptor)
            except OSError:
                pass
        if temporary_name is not None:
            try:
                current_identity = _directory_entry_identity(directory, temporary_name)
                if current_identity == temporary_identity:
                    os.unlink(temporary_name, dir_fd=directory)
            except OSError:
                pass
        raise
    finally:
        os.close(directory)


def validate_command(args: argparse.Namespace) -> int:
    inventory = load_inventory(args.inventory)
    print(
        json.dumps(
            {
                "inventory_digest": inventory.inventory_digest,
                "artifact_digest": inventory.artifact_digest,
            },
            sort_keys=True,
        )
    )
    return 0


def plan_command(args: argparse.Namespace) -> int:
    inventory = load_inventory(args.inventory)
    plan = build_plan(inventory, read_json(args.live_state), read_json(args.operations))
    output = Path(args.output) if args.output else Path(args.state_dir) / "plan.json"
    write_private(output, plan.to_dict())
    print(
        json.dumps(
            {"plan": str(output), "plan_digest": plan.plan_digest}, sort_keys=True
        )
    )
    return 0


def status_command(args: argparse.Namespace) -> int:
    inventory = load_inventory(args.inventory)
    live = read_json(args.live_state)
    if not isinstance(live, Mapping):
        raise ApplyError("live state must be an object")
    live_state = live.get("state", live.get("live_state", {}))
    if not isinstance(live_state, Mapping):
        raise ApplyError("live state mapping is invalid")
    plan = plan_from_dict(read_json(args.plan))
    verify_plan(plan)
    current_live_digest = digest(live_state)
    desired_agrees = (
        hmac.compare_digest(plan.inventory_digest, inventory.inventory_digest)
        and hmac.compare_digest(plan.artifact_digest, inventory.artifact_digest)
        and plan.target_endpoint == inventory_endpoint(inventory, plan.target_profile)
    )
    live_agrees = hmac.compare_digest(plan.live_state_digest, current_live_digest)
    print(
        json.dumps(
            {
                "desired_agrees": desired_agrees,
                "live_agrees": live_agrees,
                "plan_agrees": True,
                "inventory_digest": inventory.inventory_digest,
                "artifact_digest": inventory.artifact_digest,
                "live_state_digest": current_live_digest,
                "plan_digest": plan.plan_digest,
            },
            sort_keys=True,
        )
    )
    return 0


def apply_command(args: argparse.Namespace) -> int:
    if ENVIRONMENT_NAME.fullmatch(args.token_env) is None:
        raise ApplyError("token environment locator is invalid")
    if not os.environ.get(args.token_env):
        raise ApplyError("data-plane token is unavailable")
    inventory = load_inventory(args.inventory)
    raw_plan = read_json(args.plan)
    mutation = isinstance(raw_plan, dict) and "base_plan" in raw_plan
    plan = mutation_plan_from_dict(raw_plan) if mutation else plan_from_dict(raw_plan)
    base_plan = plan.base_plan if mutation else plan
    if (
        not hmac.compare_digest(base_plan.inventory_digest, inventory.inventory_digest)
        or not hmac.compare_digest(base_plan.artifact_digest, inventory.artifact_digest)
        or base_plan.target_profile != args.profile
        or base_plan.target_endpoint
        != inventory_endpoint(inventory, base_plan.target_profile)
    ):
        raise ApplyError("plan does not match the selected inventory and profile")
    desired_artifacts: dict[str, Any] = {}
    for profile in inventory.profiles:
        payload = deep_thaw(profile.get("config", profile))
        desired_artifacts[digest(payload)] = payload
    for bank in inventory.banks:
        payload = deep_thaw(bank.get("config", bank))
        desired_artifacts[digest(payload)] = payload
        for collection in ("models", "directives"):
            for item in bank.get(collection, ()):
                value = deep_thaw(item)
                desired_artifacts[digest(value)] = value
    for provider in inventory.providers:
        for item in provider.get("models", ()):
            value = deep_thaw(item)
            desired_artifacts[digest(value)] = value

    def resolve_desired_artifact(action: Any) -> Any:
        artifact_digest = action.details.get("artifact_digest")
        if artifact_digest not in desired_artifacts:
            raise ApplyError("desired artifact is absent from the selected inventory")
        return deep_thaw(desired_artifacts[artifact_digest])

    def reserve_external_action(control: Mapping[str, Any]) -> None:
        reservation_id = digest(
            {
                "plan_digest": control.get("plan_digest"),
                "action_id": control.get("action_id"),
                "action_kind": control.get("action_kind"),
            }
        )
        marker = (
            Path(args.state_dir)
            / "external-action-reservations"
            / f"{reservation_id}.json"
        )
        try:
            write_private(
                marker,
                {
                    "schema_version": 1,
                    "status": "indeterminate",
                    "control": dict(control),
                },
                create_only=True,
            )
        except OSError:
            raise ApplyError(
                "external action is already reserved and requires reconciliation"
            ) from None

    data_plane = HttpAdapter(
        inventory=inventory,
        profile_id=args.profile,
        token_resolver=lambda: os.environ.get(args.token_env, ""),
        artifact_resolver=resolve_desired_artifact,
        external_action_reserver=reserve_external_action,
    )
    adapter: Any = data_plane
    completion_marker: Path | None = None
    proposal_log: str | None = None
    if mutation:
        archive_paths = getattr(args, "migration_archive", None) or []
        evidence_path = getattr(args, "restore_evidence", None)
        if not archive_paths or not evidence_path:
            raise ApplyError(
                "mutation apply requires archives and disposable restore evidence"
            )
        archives: dict[str, str] = {}
        for archive_value in archive_paths:
            archive = Path(archive_value)
            archives[_regular_file_digest(archive, "migration archive")] = str(archive)
        try:
            evidence_record = read_file_evidence(
                evidence_path, "disposable restore evidence"
            )
            assert evidence_record is not None
            restore_evidence = strict_json_loads(evidence_record[0])
        except (
            FileEvidenceError,
            StrictJsonError,
            UnicodeDecodeError,
            json.JSONDecodeError,
        ):
            raise ApplyError("disposable restore evidence is unavailable") from None
        if not isinstance(restore_evidence, dict):
            raise ApplyError(
                "disposable restore evidence must be a digest-keyed object"
            )
        required_archive_digests = {
            action.details["archive_digest"] for action in plan.actions
        }
        rollback_archive = getattr(args, "rollback_archive", None)
        required_evidence = required_archive_digests | {plan.rollback_archive_digest}
        if (
            not rollback_archive
            or not required_archive_digests <= set(archives)
            or not required_evidence <= set(restore_evidence)
        ):
            raise ApplyError(
                "approved mutation archive or restore evidence does not match the plan"
            )
        if _paths_overlap(rollback_archive, list(archives.values())):
            raise ApplyError(
                "rollback archive must be distinct from every migration archive"
            )
        admin_value = getattr(args, "admin_executable", None)
        if not isinstance(admin_value, str) or not Path(admin_value).is_absolute():
            raise ApplyError(
                "mutation apply requires an absolute hindsight-admin executable"
            )
        migration = dict(inventory.migration)
        artifact_dir = Path(
            migration.get("artifact_dir", migration.get("artifact_path"))
        )
        proposal_log = migration.get("proposal_log", migration.get("proposal_path"))
        completion_marker = (
            Path(args.completion_marker)
            if args.completion_marker
            else artifact_dir / "distillation-complete.marker"
        )
        protected_apply_inputs = [
            *archives.values(),
            args.inventory,
            args.plan,
            evidence_path,
            admin_value,
            completion_marker,
            proposal_log,
        ]
        if _paths_overlap(rollback_archive, protected_apply_inputs):
            raise ApplyError("rollback archive must be distinct from every apply input")
        admin = AdminMigrationAdapter(
            admin_executable=admin_value,
            argv_factory=hindsight_admin_argv,
            runner=subprocess.run,
            environment={
                key: os.environ[key]
                for key in sorted(ADMIN_ENVIRONMENT_ALLOWLIST)
                if key in os.environ
            },
        )
        adapter = MigrationApplyAdapter(
            data_plane=data_plane,
            admin=admin,
            archives=archives,
            restore_evidence=restore_evidence,
            rollback_archive=str(Path(rollback_archive)),
            rollback_archive_digest=plan.rollback_archive_digest,
            rollback_restore_evidence_digest=plan.rollback_restore_evidence_digest,
            restore_lock_dir=str(Path(args.state_dir) / "migration-restore-locks"),
            archive_verifier=lambda path, expected: hmac.compare_digest(
                _regular_file_digest(path, "rollback archive"),
                expected,
            ),
        )
    try:
        rollback_bundle = create_rollback_bundle(plan, adapter)
    except MigrationAdapterError:
        raise ApplyError(
            "rollback archive creation or digest verification failed"
        ) from None
    gate: dict[str, Any] = {"rollback_bundle": rollback_bundle}
    if mutation:
        assert completion_marker is not None and proposal_log is not None
        gate["migration_gate"] = capture_migration_gate(completion_marker, proposal_log)
    result = apply_plan(plan, adapter, args.approval_digest, gate)
    print(
        json.dumps(
            {
                "activation_enabled": result.activation_enabled,
                "applied_action_ids": list(result.applied_action_ids),
                "reason": result.reason,
                "rollback_attempted": result.rollback_attempted,
                "rollback_succeeded": result.rollback_succeeded,
                "status": result.status,
            },
            sort_keys=True,
        )
    )
    return 0 if result.status == "applied" else 2


def migration_discover_command(args: argparse.Namespace) -> int:
    if not args.read_only:
        raise MigrationError("migration discovery requires --read-only")
    if ENVIRONMENT_NAME.fullmatch(args.token_env) is None:
        raise MigrationError("token environment locator is invalid")
    if not os.environ.get(args.token_env):
        raise MigrationError("data-plane token is unavailable")
    inventory = load_inventory(args.inventory)
    manifest = read_json(args.offline_package_manifest)
    private_catalog_digests = read_json(args.private_catalog_digests)
    adapter = HttpAdapter(
        inventory=inventory,
        profile_id=args.profile,
        token_resolver=lambda: os.environ.get(args.token_env, ""),
    )
    migration = dict(inventory.migration)
    artifact_dir = migration.get("artifact_dir", migration.get("artifact_path"))
    proposal_log = migration.get("proposal_log", migration.get("proposal_path"))
    timestamp = args.timestamp or datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    result = discover_migration_state(
        adapter,
        source_bank=BankRef(args.profile, args.source_bank),
        candidate_bank=BankRef(args.profile, args.candidate_bank),
        offline_package_manifest=manifest,
        approved_offline_package_digest=args.approved_offline_package_digest,
        migration_paths={
            "artifact_dir": artifact_dir,
            "completion_marker": args.completion_marker,
            "proposal_log": proposal_log,
        },
        retain_watermark_reader=lambda: read_json(args.retain_watermarks),
        controller_state_reader=lambda:
            _harness_reconciliation_controller_state(
                args.harness_reconciliation_config
            ),
        private_catalog_digests=private_catalog_digests,
        timestamp=timestamp,
    )
    print(
        json.dumps(
            {
                "approved": False,
                "blockers": list(result.blockers),
                "complete": result.complete,
                "inventory_digest": result.inventory_digest,
                "run_dir": result.run_dir,
                "shadow_plan_digest": result.shadow_plan_digest,
            },
            sort_keys=True,
        )
    )
    return 0 if result.complete else 2


def _replay_http_adapter(args: argparse.Namespace) -> HttpAdapter:
    if ENVIRONMENT_NAME.fullmatch(args.token_env) is None:
        raise ReplayError("replay token environment locator is invalid")
    if not os.environ.get(args.token_env):
        raise ReplayError("replay data-plane token is unavailable")
    return HttpAdapter(
        inventory=load_inventory(args.inventory),
        profile_id=args.profile,
        token_resolver=lambda: os.environ.get(args.token_env, ""),
        timeout=30.0,
    )


def _replay_plan_and_receipts(
    plan_path: str,
    receipts_path: str,
) -> tuple[Mapping[str, Any], list[Mapping[str, Any]]]:
    plan = verify_replay_plan(read_json(plan_path))
    return plan, _replay_receipts_for_plan(plan, receipts_path)


def _replay_receipts_for_plan(
    plan: Mapping[str, Any],
    receipts_path: str,
) -> list[Mapping[str, Any]]:
    artifact = read_json(receipts_path)
    if (
        not isinstance(artifact, Mapping)
        or set(artifact) != {"schema_version", "plan_digest", "receipts"}
        or type(artifact["schema_version"]) is not int
        or artifact["schema_version"] != 1
        or not isinstance(artifact["receipts"], list)
        or artifact["plan_digest"] != plan["plan_digest"]
    ):
        raise ReplayError("replay receipt artifact is invalid")
    return artifact["receipts"]


def migration_replay_plan_command(args: argparse.Namespace) -> int:
    adapter = _replay_http_adapter(args)
    plan = create_replay_plan(
        adapter,
        source_bank=BankRef(args.profile, args.source_bank),
        target_bank=BankRef(args.profile, args.target_bank),
    )
    write_private(args.output, plan, create_only=True)
    print(
        json.dumps(
            {
                "document_count": len(plan["documents"]),
                "output": str(Path(args.output)),
                "plan_digest": plan["plan_digest"],
                "source_generation": plan["source_generation"],
            },
            sort_keys=True,
        )
    )
    return 0


def migration_replay_apply_command(args: argparse.Namespace) -> int:
    adapter = _replay_http_adapter(args)
    plan = verify_replay_plan(read_json(args.plan))
    backup_evidence = read_json(args.backup_evidence)
    expected_authorization = replay_apply_authorization_digest(
        plan,
        backup_evidence,
    )
    if not hmac.compare_digest(
        args.approval_digest.encode("utf-8"),
        expected_authorization.encode("ascii"),
    ):
        raise ReplayError("replay mutation authorization does not match")
    receipt_path = Path(args.receipts)
    existing: list[Mapping[str, Any]] = []
    if receipt_path.exists():
        existing = _replay_receipts_for_plan(
            plan,
            args.receipts,
        )

    def checkpoint(receipts: Any) -> None:
        write_private(
            receipt_path,
            {
                "schema_version": 1,
                "plan_digest": plan["plan_digest"],
                "receipts": list(receipts),
            },
        )

    receipts = apply_replay_plan(
        adapter,
        plan,
        approval_digest=args.approval_digest,
        backup_evidence=backup_evidence,
        existing_receipts=existing,
        timeout_seconds=args.timeout_seconds,
        poll_interval_seconds=args.poll_interval_seconds,
        receipt_writer=checkpoint,
    )
    checkpoint(receipts)
    status = replay_receipt_status(plan, receipts)
    print(json.dumps(status, sort_keys=True))
    return 0


def migration_replay_status_command(args: argparse.Namespace) -> int:
    plan = verify_replay_plan(read_json(args.plan))
    receipts = (
        _replay_receipts_for_plan(plan, args.receipts)
        if Path(args.receipts).exists()
        else []
    )
    print(json.dumps(replay_receipt_status(plan, receipts), sort_keys=True))
    return 0


def migration_replay_verify_command(args: argparse.Namespace) -> int:
    adapter = _replay_http_adapter(args)
    plan, receipts = _replay_plan_and_receipts(args.plan, args.receipts)
    result = verify_replay_receipts(adapter, plan, receipts)
    write_private(args.output, result, create_only=True)
    print(json.dumps(result, sort_keys=True))
    return 0


def migration_replay_closeout_command(args: argparse.Namespace) -> int:
    if args.prepare:
        if args.closeout_plan or args.approval_digest:
            raise ReplayError(
                "replay closeout preparation cannot include mutation authority"
            )
    elif not args.closeout_plan or not args.approval_digest:
        raise ReplayError(
            "replay closeout apply requires plan and approval digest"
        )
    adapter = _replay_http_adapter(args)
    plan, receipts = _replay_plan_and_receipts(args.plan, args.receipts)
    verification = read_json(args.verification)
    backup_evidence = read_json(args.backup_evidence)
    if args.prepare:
        closeout = create_replay_closeout_plan(
            adapter,
            plan,
            verification,
            backup_evidence,
        )
        write_private(args.output, closeout, create_only=True)
        print(json.dumps(closeout, sort_keys=True))
        return 0
    receipt = apply_replay_closeout(
        adapter,
        plan,
        receipts,
        verification,
        backup_evidence,
        read_json(args.closeout_plan),
        approval_digest=args.approval_digest,
    )
    write_private(args.output, receipt, create_only=True)
    print(json.dumps(receipt, sort_keys=True))
    return 0


def _generic_import_http_adapter(args: argparse.Namespace) -> HttpAdapter:
    if ENVIRONMENT_NAME.fullmatch(args.token_env) is None:
        raise GenericImportError(
            "generic import token environment locator is invalid"
        )
    if not os.environ.get(args.token_env):
        raise GenericImportError("generic import data-plane token is unavailable")
    return HttpAdapter(
        inventory=load_inventory(args.inventory),
        profile_id=args.profile,
        token_resolver=lambda: os.environ.get(args.token_env, ""),
        timeout=30.0,
    )


def _generic_import_receipts(
    plan: Mapping[str, Any],
    path: str,
) -> list[Mapping[str, Any]]:
    artifact = read_json(path)
    if (
        not isinstance(artifact, Mapping)
        or set(artifact) != {"schema_version", "plan_digest", "receipts"}
        or type(artifact["schema_version"]) is not int
        or artifact["schema_version"] != 1
        or artifact["plan_digest"] != plan["plan_digest"]
        or not isinstance(artifact["receipts"], list)
    ):
        raise GenericImportError("generic import receipt artifact is invalid")
    return artifact["receipts"]


def generic_import_inspect_command(args: argparse.Namespace) -> int:
    adapter = _generic_import_http_adapter(args)
    projection = projection_from_dict(read_json(args.projection))
    inspection = inspect_import_target(
        adapter,
        projection,
        BankRef(args.profile, args.target_bank),
    )
    write_private(args.output, inspection, create_only=True)
    counts = {"exact_duplicate": 0, "novelty_candidate": 0}
    for finding in inspection["findings"]:
        counts[finding["status"]] += 1
    print(
        json.dumps(
            {
                "exact_duplicate_count": counts["exact_duplicate"],
                "inspection_digest": inspection["inspection_digest"],
                "novelty_candidate_count": counts["novelty_candidate"],
                "output": str(Path(args.output)),
                "target_generation":
                    inspection["controller_snapshot"]["target_generation"],
            },
            sort_keys=True,
        )
    )
    return 0


