                "output": str(Path(args.output)),
                "plan_digest": plan["plan_digest"],
                "target_generation": plan["target_generation"],
            },
            sort_keys=True,
        )
    )
    return 0


def generic_import_apply_command(args: argparse.Namespace) -> int:
    adapter = _generic_import_http_adapter(args)
    plan = verify_generic_import_plan(read_json(args.plan))
    projection = projection_from_dict(read_json(args.projection))
    receipt_path = Path(args.receipts)
    existing = (
        _generic_import_receipts(plan, args.receipts)
        if receipt_path.exists()
        else []
    )

    def checkpoint(receipts: Sequence[Mapping[str, Any]]) -> None:
        write_private(
            receipt_path,
            {
                "schema_version": 1,
                "plan_digest": plan["plan_digest"],
                "receipts": list(receipts),
            },
        )

    receipts = apply_generic_import_plan(
        adapter,
        plan,
        projection,
        read_json(args.replay_closeout_receipt),
        read_json(args.backup_evidence),
        approval_digest=args.approval_digest,
        existing_receipts=existing,
        timeout_seconds=args.timeout_seconds,
        poll_interval_seconds=args.poll_interval_seconds,
        receipt_writer=checkpoint,
    )
    checkpoint(receipts)
    print(json.dumps(generic_import_status(plan, receipts), sort_keys=True))
    return 0


